# Hosted agent service (tools/agent-service) — see tools/agent-service/README.md.
# Deploy from the repo root with:
#   docker compose --env-file .env -f tools/agent-service/docker-compose.yml up -d
# (or `npm run agent-service` for local development).
#
# Required: shared bearer-token secret Foundry authenticates with. Generate
# with `openssl rand -hex 32`, and set the same value in each GM's
# "Agent Service API Key" module setting. The service refuses to start
# without it.
AGENT_SERVICE_API_KEY=

# Optional settings below are commented out: leave them that way unless you
# need them (an empty `NAME=` line is read as an empty string, not unset).
#
# Optional: combat-decision provider, `litellm` (default) or `laya`.
# PF2EDC_AGENT_PROVIDER=laya
# Optional, only for PF2EDC_AGENT_PROVIDER=laya: your self-hosted Laya
# instance and its bearer token (if it requires one).
# LAYA_API_KEY=
# LAYA_BASE_URL=
# Optional: CORS Access-Control-Allow-Origin value. Defaults to `*`; set it
# to your Foundry origin (e.g. https://foundry.yourdomain.com) to lock it down.
# AGENT_SERVICE_ALLOWED_ORIGIN=
#
# Optional: base URL of the litellm proxy sidecar. Defaults to
# `http://litellm:4000/v1` (the compose-network hostname); only needs
# overriding for non-compose deployments.
# LITELLM_BASE_URL=http://litellm:4000/v1
# Optional: bearer token for the litellm sidecar, if it's configured to
# require one.
# LITELLM_API_KEY=
# Optional: request timeout in milliseconds for flavor-customization calls
# through litellm. Defaults to 300000 (5 minutes) — local inference on
# modest hardware is genuinely slow, minutes not seconds per request.
# LITELLM_TIMEOUT_MS=300000
# Optional: request timeout in milliseconds for combat-decision calls
# through litellm. Defaults to 30000, kept under Foundry's 35s client-side
# combat-decision timeout so a stuck upstream call fails promptly instead
# of tying up Ollama's serial request queue.
# LITELLM_COMBAT_TIMEOUT_MS=30000
# Optional: candidate-count threshold above which combat decisions request
# the `reasoning` model tier instead of `fast`. Defaults to 8 (more than 8
# candidates routes to `reasoning`).
# COMBAT_REASONING_CANDIDATE_THRESHOLD=8

# Foundry REST API relay — point this at a self-hosted
# ThreeHats/foundryvtt-rest-api-relay instance (unlimited requests) rather than
# the public foundryrestapi.com (100 req/mo free tier). Only used for live
# verification via the foundry-rest skill; NOT required to build or ship the
# module or to run the agent service.
FOUNDRY_BASE_URL=
FOUNDRY_REST_API_KEY=

# ComfyUI server (creature token-art generation). Override if not using the
# default.
COMFYUI_BASE_URL=https://comfyui.example.com
