# Hosted agent service (tools/agent-service) — see tools/agent-service/README.md.
# Deploy from the repo root with:
#   docker compose --env-file .env -f tools/agent-service/docker-compose.yml up -d
# (or `npm run agent-service` for local development).
#
# Required: shared bearer-token secret Foundry authenticates with. Generate
# with `openssl rand -hex 32`, and set the same value in each GM's
# "Agent Service API Key" module setting. The service refuses to start
# without it.
AGENT_SERVICE_API_KEY=
# Required for the default `claude` decision provider, and for
# flavor-customization generation unless AGENT_SERVICE_CUSTOMIZATION_PROVIDER
# below is set to `local`.
ANTHROPIC_API_KEY=

# Optional settings below are commented out: leave them that way unless you
# need them (an empty `NAME=` line is read as an empty string, not unset).
#
# Optional: combat-decision provider, `claude` (default) or `laya`.
# PF2EDC_AGENT_PROVIDER=laya
# Optional, only for PF2EDC_AGENT_PROVIDER=laya: your self-hosted Laya
# instance and its bearer token (if it requires one).
# LAYA_API_KEY=
# LAYA_BASE_URL=
# Optional: CORS Access-Control-Allow-Origin value. Defaults to `*`; set it
# to your Foundry origin (e.g. https://foundry.yourdomain.com) to lock it down.
# AGENT_SERVICE_ALLOWED_ORIGIN=
#
# Optional: flavor-customization (trap/skill-challenge/puzzle/narrative/
# treasure text) provider, `claude` (default) or `local`. `local` talks to a
# self-hosted, OpenAI-compatible chat-completions server (e.g. Ollama)
# instead, so no ANTHROPIC_API_KEY is needed for this endpoint. See
# "Using a local model instead of Claude" in tools/agent-service/README.md.
# AGENT_SERVICE_CUSTOMIZATION_PROVIDER=local
# Required when AGENT_SERVICE_CUSTOMIZATION_PROVIDER=local: base URL of your
# local OpenAI-compatible server, INCLUDING any API-version path segment it
# needs (e.g. Ollama's `/v1`). From inside the agent-service's own Docker
# container, use host.docker.internal (added to extra_hosts) to reach a
# host-run server — plain `localhost` refers to the container itself.
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# Required when AGENT_SERVICE_CUSTOMIZATION_PROVIDER=local: the model name
# as your local server knows it (must support tool/function calling).
# LOCAL_LLM_MODEL=qwen2.5:3b-instruct
# Optional, only for AGENT_SERVICE_CUSTOMIZATION_PROVIDER=local: bearer
# token, for local servers that require auth (most, including Ollama,
# don't).
# LOCAL_LLM_API_KEY=
# Optional, only for AGENT_SERVICE_CUSTOMIZATION_PROVIDER=local: request
# timeout in milliseconds. Defaults to 300000 (5 minutes) — local inference
# on modest hardware is genuinely slow, minutes not seconds per request.
# LOCAL_LLM_TIMEOUT_MS=300000

# Foundry REST API relay — point this at a self-hosted
# ThreeHats/foundryvtt-rest-api-relay instance (unlimited requests) rather than
# the public foundryrestapi.com (100 req/mo free tier). Only used for live
# verification via the foundry-rest skill; NOT required to build or ship the
# module or to run the agent service.
FOUNDRY_BASE_URL=
FOUNDRY_REST_API_KEY=

# ComfyUI server (creature token-art generation). Override if not using the
# default.
COMFYUI_BASE_URL=https://comfyui.example.com
