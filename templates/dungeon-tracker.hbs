{{#if hasScene}}
  {{#if hasRun}}
    <div class="pf2edc-dungeon">
      {{#unless interactive}}
        <p class="hint">{{localize "PF2EDC.Dungeon.ReadOnlyHint" host=hostName}}</p>
      {{/unless}}
      <div class="pf2edc-dungeon__progress">
        {{#if completed}}
          {{localize "PF2EDC.Dungeon.Completed"}}
        {{else}}
          {{#if isSafeRoom}}
            {{currentRoom.kindLabel}}
          {{else}}
            {{localize
              "PF2EDC.Dungeon.ProgressLabel"
              n=roomNumber
              total=roomTotal
            }}
          {{/if}}
        {{/if}}
      </div>

      {{#if objective}}
        <p class="pf2edc-dungeon__objective">{{localize
            "PF2EDC.Dungeon.CurrentObjective"
            objective=objective
          }}</p>
      {{/if}}

      {{#if currentRoom}}
        <div class="pf2edc-dungeon__room">
          {{#if currentRoom.isGoal}}
            <strong>{{localize "PF2EDC.Dungeon.Kind.goal"}}</strong>
          {{else}}
            <strong>{{currentRoom.kindLabel}}</strong>
          {{/if}}

          {{#if currentRoom.setpiece}}
            <p
              class="pf2edc-dungeon__setpiece-name"
            >{{currentRoom.setpiece.name}}</p>
            {{#if currentRoom.setpiece.playerDescription}}
              <p>{{currentRoom.setpiece.playerDescription}}</p>
              {{#if isGM}}
                <p class="pf2edc-dungeon__setpiece-gm-note"><em>{{localize
                    "PF2EDC.Dungeon.Setpiece.GmNoteLabel"
                  }}</em> {{currentRoom.setpiece.summary}}</p>
              {{/if}}
            {{else}}
              <p>{{currentRoom.setpiece.summary}}</p>
            {{/if}}
          {{/if}}
        </div>
      {{/if}}

      {{#unless completed}}
        <p class="hint">{{localize
            "PF2EDC.Dungeon.ThemeReminder"
            traits=traits
            excludeTraits=excludeTraits
          }}</p>
        {{#if isSafeRoom}}
          {{#unless nextRoomPending}}
            {{#if isSafeEntry}}
              <p class="hint">{{localize "PF2EDC.Dungeon.SafeEntryHint"}}</p>
            {{else}}
              <p class="hint">{{localize "PF2EDC.Dungeon.SafeRestHint"}}</p>
            {{/if}}
          {{/unless}}
        {{else}}
          {{#if isCombatRoom}}
            {{#if combatActive}}
              <p class="hint">{{localize
                  "PF2EDC.Dungeon.Combat.InProgressHint"
                }}</p>
              <footer>
                <button type="button" data-action="openCombatTracker">{{localize
                    "PF2EDC.Dungeon.Combat.OpenTrackerButton"
                  }}</button>
                <button type="button" data-action="declareVictory">{{localize
                    "PF2EDC.Dungeon.Combat.DeclareVictoryButton"
                  }}</button>
                <button type="button" data-action="declareDefeat">{{localize
                    "PF2EDC.Dungeon.Combat.DeclareDefeatButton"
                  }}</button>
              </footer>
            {{/if}}
            {{#if combatMissing}}
              <footer>
                <button
                  type="button"
                  data-action="startCombatRecovery"
                >{{localize "PF2EDC.Dungeon.Combat.StartCombatButton"}}</button>
              </footer>
            {{/if}}
          {{else if isSkillChallenge}}
            <div class="pf2edc-dungeon__skill-challenge">
              {{#if challenge.templateName}}
                <p
                  class="pf2edc-dungeon__setpiece-name"
                >{{challenge.templateName}}</p>
                <p>{{challenge.templateSummary}}</p>
              {{/if}}
              <p>{{localize
                  "PF2EDC.Dungeon.SkillChallenge.Progress"
                  vp=challenge.vp
                  target=challenge.vpTarget
                }}</p>
              <p class="hint">{{localize
                  "PF2EDC.Dungeon.SkillChallenge.AttemptsRemaining"
                  n=challenge.attemptsRemaining
                }}</p>
              {{#if challenge.templateName}}
                <ul class="pf2edc-dungeon__skill-flavor">
                  {{#each challenge.specialtySkills}}
                    <li>
                      <strong>{{this.label}}</strong>
                      {{#if this.flavor}}— {{this.flavor}}{{/if}}
                    </li>
                  {{/each}}
                </ul>
              {{else}}
                <p class="hint">
                  {{localize "PF2EDC.Dungeon.SkillChallenge.SpecialtyHint"}}
                  {{#each challenge.specialtySkills}}{{this.label}}{{#unless
                      @last
                    }}, {{/unless}}{{/each}}
                </p>
              {{/if}}
              <form class="pf2edc-dungeon__skill-challenge-form">
                <label>
                  {{localize "PF2EDC.Dungeon.SkillChallenge.WhoLabel"}}
                  <select name="actorId">
                    {{#each partyMembers}}
                      <option value="{{this.id}}">{{this.name}}</option>
                    {{/each}}
                  </select>
                </label>
                <label>
                  {{localize "PF2EDC.Dungeon.SkillChallenge.SkillLabel"}}
                  <select name="skill">
                    {{#each challenge.allSkills}}
                      <option value="{{this.slug}}">{{this.label}}{{#if
                          this.isSpecialty
                        }} *{{/if}}</option>
                    {{/each}}
                  </select>
                </label>
                <button
                  type="button"
                  data-action="attemptSkillChallenge"
                >{{localize
                    "PF2EDC.Dungeon.SkillChallenge.AttemptButton"
                  }}</button>
              </form>
            </div>
          {{else if isNarrativeRoom}}
            <div class="pf2edc-dungeon__narrative">
              {{#unless currentRoom.setpiece}}
                <p class="hint">{{localize
                    "PF2EDC.Dungeon.Narrative.Placeholder"
                  }}</p>
              {{/unless}}
              {{! #165: archetype-specific extras — none, one, or another of
                these renders depending on which archetype was drawn; the
                shared name/summary already rendered above via the generic
                currentRoom.setpiece block. }}
              {{#if narrative.revealText}}
                <p class="pf2edc-dungeon__narrative-reveal">{{narrative.revealText}}</p>
              {{/if}}
              {{#if narrative.npcHook}}
                <p class="pf2edc-dungeon__narrative-npc">
                  <strong>{{narrative.npcName}}</strong> — {{narrative.npcHook}}
                </p>
              {{/if}}
              {{#if narrative.options}}
                {{! #208: a choice-archetype room resolves through its own
                  two option buttons instead of the plain Continue form —
                  the picked option's own consequence text becomes the
                  run's objective directly, so there's nothing left to
                  free-type. }}
                <div class="pf2edc-dungeon__narrative-options">
                  {{#each narrative.options}}
                    <button
                      type="button"
                      data-action="chooseNarrativeOption"
                      data-option-index="{{@index}}"
                    ><strong>{{this.label}}</strong> — {{this.consequence}}</button>
                  {{/each}}
                </div>
              {{else}}
                <form class="pf2edc-dungeon__narrative-form">
                  <label>
                    {{localize "PF2EDC.Dungeon.Narrative.ObjectiveLabel"}}
                    <textarea
                      name="pf2edc-narrative-objective"
                      placeholder="{{localize
                        'PF2EDC.Dungeon.Narrative.ObjectivePlaceholder'
                      }}"
                    >{{narrative.suggestedObjective}}</textarea>
                  </label>
                  <button type="button" data-action="continueNarrative">{{localize
                      "PF2EDC.Dungeon.Narrative.ContinueButton"
                    }}</button>
                </form>
              {{/if}}
            </div>
          {{else if isTreasureRoom}}
            <div class="pf2edc-dungeon__treasure">
              {{#unless currentRoom.setpiece}}
                <p class="hint">{{localize
                    "PF2EDC.Dungeon.Treasure.Placeholder"
                  }}</p>
              {{/unless}}
              <footer>
                <button type="button" data-action="claimTreasure">{{localize
                    "PF2EDC.Dungeon.Treasure.ClaimButton"
                  }}</button>
              </footer>
            </div>
          {{else if isPuzzleRoom}}
            <div class="pf2edc-dungeon__puzzle">
              {{! puzzle.summary is already shown above via the generic
                  currentRoom.setpiece block, which reads the same
                  (possibly agent-customized) persisted summary - not
                  repeated here. }}
              <p>{{localize
                  "PF2EDC.Dungeon.Puzzle.Progress"
                  successes=puzzle.successes
                  target=puzzle.requiredSuccesses
                }}</p>
              <ul class="pf2edc-dungeon__puzzle-stages">
                {{#each puzzle.stages}}
                  <li>
                    {{#if this.attempted}}
                      {{#if this.succeeded}}
                        <strong>{{this.skillLabel}}</strong>
                        — {{this.hint}}
                      {{else}}
                        <span class="hint">{{localize
                            "PF2EDC.Dungeon.Puzzle.StageFailed"
                            skill=this.skillLabel
                          }}</span>
                      {{/if}}
                    {{else}}
                      <form
                        class="pf2edc-dungeon__puzzle-stage-form"
                        data-stage-index="{{this.index}}"
                      >
                        <label>
                          {{localize
                            "PF2EDC.Dungeon.Puzzle.StageLabel"
                            skill=this.skillLabel
                          }}
                          <select name="actorId">
                            {{#each ../partyMembers}}
                              <option value="{{this.id}}">{{this.name}}</option>
                            {{/each}}
                          </select>
                        </label>
                        <button
                          type="button"
                          data-action="attemptPuzzleStage"
                          data-stage-index="{{this.index}}"
                        >{{localize "PF2EDC.Dungeon.Puzzle.AttemptButton"}}</button>
                      </form>
                    {{/if}}
                  </li>
                {{/each}}
              </ul>
              {{#if puzzle.solution}}
                <p class="pf2edc-dungeon__puzzle-solution">{{puzzle.solution}}</p>
              {{/if}}
            </div>
          {{else}}
            {{#unless currentRoomResolved}}
              <footer>
                <button type="button" data-action="succeed">{{localize
                    "PF2EDC.Dungeon.SucceedButton"
                  }}</button>
                <button type="button" data-action="fail">{{localize
                    "PF2EDC.Dungeon.FailButton"
                  }}</button>
              </footer>
            {{/unless}}
          {{/if}}
        {{/if}}
        {{#if nextRoomPending}}
          <p class="hint">{{localize "PF2EDC.Dungeon.DoorLockedHint"}}</p>
          <footer>
            <button type="button" data-action="populateNext">{{localize
                "PF2EDC.Dungeon.PopulateNextButton"
              }}</button>
          </footer>
        {{/if}}
        {{#if canUndo}}
          <footer>
            <button type="button" data-action="undo">{{localize
                "PF2EDC.Dungeon.UndoButton"
              }}</button>
          </footer>
        {{/if}}
      {{/unless}}

      {{#if history.length}}
        <div class="pf2edc-dungeon__history">
          {{#each history}}
            <div class="pf2edc-dungeon__history-entry">
              <span
                class="pf2edc-dungeon__history-outcome"
              >{{this.outcomeLabel}}</span>
              <span>{{this.effectLabel}}</span>
            </div>
          {{/each}}
        </div>
      {{/if}}

      <footer>
        <button type="button" data-action="hide">{{localize
            "PF2EDC.Dungeon.HideButton"
          }}</button>
        <button type="button" data-action="abandon">{{localize
            "PF2EDC.Dungeon.AbandonButton"
          }}</button>
      </footer>
    </div>
  {{else}}
    <form class="pf2edc-dungeon">
      <label>
        {{localize "PF2EDC.Dungeon.RoomCountLabel"}}
        <input
          type="number"
          name="roomCount"
          min="2"
          max="20"
          value="{{defaultRoomCount}}"
        />
      </label>
      {{{traitsFieldHtml}}}
      {{{excludeTraitsFieldHtml}}}
      <footer>
        <button type="button" data-action="start">{{localize
            "PF2EDC.Dungeon.StartButton"
          }}</button>
      </footer>
    </form>
  {{/if}}
{{else}}
  <p class="hint">{{localize "PF2EDC.Dungeon.NoSceneWarning"}}</p>
{{/if}}