{
  "name": "foundry-pf2e-dungeon-crawl",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Foundry VTT v14 module: GM-less-capable dungeon crawl for Pathfinder 2E.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:dungeon": "node tools/validate-dungeon-setpieces.mjs",
    "art:normalize": "node tools/migrate-creature-art-sources.mjs",
    "validate:creature-art": "node tools/validate-creature-art.mjs",
    "validate:decision-model": "node tools/agent-service/validate-decision-model.mjs",
    "packs:build": "node tools/build-creature-art-pack.mjs",
    "packs:check": "node tools/check-creature-art-pack.mjs",
    "audit:environments": "node tools/audit-creature-environments.mjs",
    "tokens": "node tools/generate-token-art.mjs",
    "tokens:check": "node tools/check-token-art.mjs",
    "tokens:import": "node tools/import-token.mjs",
    "prompts": "node tools/token-prompts.mjs",
    "architecture:graph": "node tools/generate-architecture-graph.mjs",
    "agent-service": "node tools/agent-service/entrypoint.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "classic-level": "^3.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "vitest": "^2.1.4"
  }
}
