{
  "name": "foundry-pf2e-dungeon-crawl",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Foundry VTT v13 module: GM-less-capable dungeon crawl for Pathfinder 2E.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:dungeon": "node tools/validate-dungeon-setpieces.mjs",
    "validate:creature-art": "node tools/validate-creature-art.mjs",
    "tokens": "node tools/generate-token-art.mjs",
    "tokens:check": "node tools/check-token-art.mjs",
    "tokens:import": "node tools/import-token.mjs",
    "prompts": "node tools/token-prompts.mjs",
    "architecture:graph": "node tools/generate-architecture-graph.mjs",
    "agent-service": "node tools/agent-service/entrypoint.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.3.3",
    "vitest": "^2.1.4"
  }
}
