14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!l8hV9kRPe05HfQ3w.p9XiybGymA4tg01N"},{"_id":"zKqGThMJiWNzcGL4","img":"systems/pf2e/icons/actions/Passive.webp","name":"Incessant Yammering","sort":400000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>15 feet.</p>\n<p>A gobmob snake's heads constantly bicker and snipe at one another, annoying and distracting anyone nearby. Each non-goblin creature that begins its turn in the aura must attempt a @Check[will|dc:21|options:area-effect] save. On a failure, it takes a –1 status penalty to Perception checks and Will saves for 1 round. On a success, it is temporarily immune for 1 minute.</p>\n<p>@UUID[Compendium.pf2e.bestiary-effects.Item.abxVJdBjmotub57z]{Effect: Incessant Yammering}</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[{"key":"Aura","radius":15,"slug":"incessant-yammering","traits":["auditory","linguistic"]}],"slug":null,"traits":{"value":["auditory","aura","linguistic"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!l8hV9kRPe05HfQ3w.zKqGThMJiWNzcGL4"},{"_id":"faPphSAlwe9IY2Il","img":"systems/pf2e/icons/actions/Passive.webp","name":"Infighting","sort":500000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>Whenever a gobmob snake critically fails at an attack roll or skill check, it must succeed at a @Check[flat|dc:5] or become @UUID[Compendium.pf2e.conditionitems.Item.xYTAsEpcJE1Ccni3]{Slowed 1} as its heads argue over which of them is to blame. An enemy can provoke an argument by attempting a @Check[deception|dc:20|traits:auditory,concentrate,linguistic,mental] check as a single action with the auditory, concentrate, linguistic, and mental traits.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[{"key":"Note","outcome":["criticalFailure"],"selector":["attack-roll","skill-check"],"text":"{item|description}","title":"{item|name}","visibility":"owner"}],"slug":null,"traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!l8hV9kRPe05HfQ3w.faPphSAlwe9IY2Il"},{"_id":"xFNPutNsLaLzFEdr","img":"systems/pf2e/icons/actions/OneAction.webp","name":"Coil","sort":600000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>The gobmob snake uses an action to coil itself, increasing its reach with its fangs from 5 to 10 feet. After the gobmob snake Strikes with its fangs, it becomes uncoiled.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[{"key":"RollOption","option":"coil","toggleable":true},{"definition":["item:slug:fangs"],"key":"AdjustStrike","mode":"add","predicate":["coil"],"property":"weapon-traits","value":"reach-10"}],"slug":null,"traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!l8hV9kRPe05HfQ3w.xFNPutNsLaLzFEdr"},{"_id":"ZtiaPGYU12BviKY1","img":"systems/pf2e/icons/actions/TwoActions.webp","name":"Goblin Breath","sort":700000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>The gobmob snake belches a cloud of nauseating vapor in a @Template[type:cone|distance:15]. Non-goblin creatures within the cloud must succeed at a @Check[fortitude|dc:20|options:area-effect,inflicts:sickened,inflicts:slowed] save or become @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1}. On a critical failur