2e/icons/actions/TwoActions.webp","name":"Jinxed Call","sort":700000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>The jinx eater gives an eerie croak. Each non-tengu in a @Template[type:emanation|distance:30] must succeed at a @Check[will|dc:21|options:inflicts:clumsy] save or be @UUID[Compendium.pf2e.conditionitems.Item.i3OJZU2nk64Df3xm]{Clumsy 1} for 1 round (or 1 minute on a critical failure). Regardless of the results, each creature is then temporarily immune to Jinxed Call for 1 minute.</p>"},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":null,"traits":{"value":["auditory","occult"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!c9MsJpiws0WfNjkJ.ldxQGW1Q2qu1yPas"},{"_id":"qRrGPu3UP7hix307","img":"systems/pf2e/icons/actions/Passive.webp","name":"Sneak Attack","sort":800000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>The jinx eater deals 1d6 extra precision damage to @UUID[Compendium.pf2e.conditionitems.Item.AJh5ex99aV6VTggg]{Off-Guard} creatures.</p>"},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[{"category":"precision","diceNumber":1,"dieSize":"d6","key":"DamageDice","predicate":["target:condition:off-guard"],"selector":"strike-damage"},{"key":"RollOption","label":"PF2E.SpecificRule.TOTMToggle.OffGuard","option":"target:condition:off-guard","toggleable":"totm"}],"slug":null,"traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!c9MsJpiws0WfNjkJ.qRrGPu3UP7hix307"},{"_id":"yQ29MdOO2pfWO4ue","img":"systems/pf2e/icons/default-icons/lore.svg","name":"Sailing Lore","sort":900000,"system":{"description":{"value":""},"mod":{"value":12},"proficient":{"value":0},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":null,"traits":{},"_migration":{"version":0.959,"previous":null}},"type":"lore","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!c9MsJpiws0WfNjkJ.yQ29MdOO2pfWO4ue"}],"name":"Jinx Eater","system":{"abilities":{"cha":{"mod":2},"con":{"mod":1},"dex":{"mod":4},"int":{"mod":1},"str":{"mod":2},"wis":{"mod":1}},"attributes":{"ac":{"details":"","value":21},"allSaves":{"value":""},"hp":{"details":"","max":65,"temp":0,"value":65},"speed":{"otherSpeeds":[],"value":25}},"details":{"blurb":"","languages":{"details":"plus two others","value":["common","tengu"]},"level":{"value":4},"privateNotes":"","publicNotes":"<p>Whether kidnapped, conscripted, or having entered voluntary service, a tengu in the role of jinx eater on a ship's crew is tasked with keeping the crew free of misfortune. Those with the necessary skill to do so often achieve a respected and privileged position on board.</p><hr /><p>Originally hailing from the continent of Tian Xia, tengu have spread across the globe. Though some staunchly uphold traditions, gazing at the sky from the tallest mountaintops, other tengu remain on the ground, adapting and blending into the societies in which they settle.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder NPC Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":12,"senses":[{"type":"low-light-vision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":8},"reflex":{"saveDetail":"","value":14},"will":{"saveDetail":"","value":11}},"skills":{"acrobatics":{"base":13,"special":[]},"athletics":{"base":9,"special":[]},"deception":{"base":12,"special":[]},"intimidation":{"base":12,"special":[]},"occultism":{"base":10,"special":[]}},"traits":{"rarity":"common","size