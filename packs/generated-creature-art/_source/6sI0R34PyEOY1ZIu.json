} or @UUID[Compendium.pf2e.actionspf2e.Item.SjmKHgI7a5Z9JzBx]{Force Open} the web is 30. The tether can be severed with a Strike (AC 20, Hardness 5, HP 20), but this doesn't free the restrained creature.</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":"web-tether","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!6sI0R34PyEOY1ZIu.Eu72dpTXiYJQD7Hm"}],"name":"Goliath Spider","system":{"abilities":{"cha":{"mod":-4},"con":{"mod":7},"dex":{"mod":5},"int":{"mod":-5},"str":{"mod":8},"wis":{"mod":3}},"attributes":{"ac":{"details":"","value":30},"allSaves":{"value":""},"hp":{"details":"","max":220,"temp":0,"value":220},"speed":{"otherSpeeds":[{"type":"climb","value":30}],"value":45}},"details":{"blurb":"","languages":{"details":"","value":[]},"level":{"value":11},"privateNotes":"","publicNotes":"<p>Goliath spiders dwell in the deepest jungles, where they build webs as big as temples and feast on prey as large as hippopotami.</p>\n<hr />\n<p>Few everyday vermin inspire as much dread as the infamous spider.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"web sense","mod":22,"senses":[{"type":"darkvision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":25},"reflex":{"saveDetail":"","value":21},"will":{"saveDetail":"","value":17}},"skills":{"acrobatics":{"base":18},"athletics":{"base":23},"stealth":{"base":22}},"traits":{"rarity":"common","size":{"value":"grg"},"value":["animal"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-monster-core.Actor.eP4a0FAbus3tNTbc"},"effects":[],"_key":