":[],"slug":"ghast-ghast-fever","traits":{"rarity":"common","value":["disease"]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!FY0bNok0DQiKgnnk.IdfK6A7UpGkscuOG"},{"_id":"GBiarRqqq8qwyZtJ","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-family-ability-glossary.Item.bVZ6KizWVTLJUBXi"},"img":"systems/pf2e/icons/actions/Passive.webp","name":"Paralysis","sort":700000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>Any living creature hit by a ghast's attack must succeed at a @Check[fortitude|dc:16|options:inflicts:paralyzed] save or become @UUID[Compendium.pf2e.conditionitems.Item.6uEgoh53GbXuHpTF]{Paralyzed}. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save.</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary"},"rules":[],"slug":"ghast-paralysis","traits":{"rarity":"common","value":["incapacitation","occult"]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!FY0bNok0DQiKgnnk.GBiarRqqq8qwyZtJ"},{"_id":"e7CxhtU5yoASkey8","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-family-ability-glossary.Item.UU1Fp3PRuTFONjC9"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Swift Leap","sort":800000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>The ghast jumps up to half its Speed. This movement doesn't trigger reactions.</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary"},"rules":[],"slug":"ghoul-swift-leap","traits":{"rarity":"common","value":["move"]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!FY0bNok0DQiKgnn