{"_id":"IbGufEpp5B1JmEbh","folder":null,"img":"modules/pf2e-dungeon-crawl/assets/creature-art/pfs-season-1-bestiary/barbed-bloodseeker-lob.webp","items":[{"_id":"pJ6UzZMsm6dL6aBt","img":"systems/pf2e/icons/default-icons/melee.svg","name":"Barbed Leg","sort":100000,"system":{"attack":{"value":""},"attackEffects":{"value":["attach"]},"bonus":{"value":9},"damageRolls":{},"description":{"value":""},"publication":{"license":"OGL","remaster":false,"title":""},"range":null,"rules":[],"slug":null,"traits":{"rarity":"common","value":["finesse"]},"_migration":{"version":0.959,"previous":null}},"type":"melee","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!IbGufEpp5B1JmEbh.pJ6UzZMsm6dL6aBt"},{"_id":"ef2SkweU3ISWsZdc","img":"systems/pf2e/icons/actions/Passive.webp","name":"Attach","sort":200000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>When a barbed bloodseeker hits a target larger than itself, its barbed legs attach it to that creature. This is similar to @UUID[Compendium.pf2e.conditionitems.Item.kWc1fhmv9LBiTuei]{Grabbing} the creature, but the bloodseeker moves with that creature rather than holding it in place.</p>\n<p>The bloodseeker is @UUID[Compendium.pf2e.conditionitems.Item.AJh5ex99aV6VTggg]{Off-Guard} while attached. If the bloodseeker is killed or pushed away while attached to a creature it has drained blood from, that creature takes @Damage[1[bleed]] damage. Escaping the attach or removing the bloodseeker in other ways doesn't cause bleed damage.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!IbGufEpp5B1JmEbh.ef2SkweU3ISWsZdc"},{"