litical gain.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Society Scenario #4-02: Return to the Grave"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":3,"senses":[]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":6},"reflex":{"saveDetail":"","value":3},"will":{"saveDetail":"","value":3}},"skills":{"athletics":{"base":5},"society":{"base":2}},"traits":{"rarity":"uncommon","size":{"value":"med"},"value":["chaotic","human","humanoid"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pfs-season-4-bestiary.Actor.r77a464nSqsntQnv"},"effects":[],"_key":"!actors!7lblc62N9Dh33zr9","prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pfs-season-4-bestiary/grim-rictus-robber-lob.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pfs_season_4_bestiary__grim_rictus_robber","sourcePack":"pf2e.pfs-season-4-bestiary","sourceDocId":"r77a464nSqsntQnv"}}}