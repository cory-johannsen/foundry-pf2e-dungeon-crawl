":"Compendium.pf2e.extinction-curse-bestiary.Actor.oJJspO9P2vDdtMYd"},"effects":[],"_key":"!actors!7ZXVIomj8aM8IK6F","prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/extinction-curse-bestiary/the-vanish-man.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"extinction_curse_bestiary__the_vanish_man","sourcePack":"pf2e.extinction-curse-bestiary","sourceDocId":"oJJspO9P2vDdtMYd"}}}