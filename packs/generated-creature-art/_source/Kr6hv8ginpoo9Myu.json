ds, or works of art salvaged from sunken ships or fallen adventurers.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder #220: Crypt of Runes"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":27,"senses":[{"type":"low-light-vision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":27},"reflex":{"saveDetail":"","value":29},"will":{"saveDetail":"","value":23}},"skills":{"acrobatics":{"base":27},"athletics":{"base":31},"stealth":{"base":29}},"traits":{"rarity":"unique","size":{"value":"lg"},"value":["aberration","aquatic"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.revenge-of-the-runelords-bestiary.Actor.EIExtvIGAnR420JB"},"effects":[],"_key":"!actors!Kr6hv8ginpoo9Myu","prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/revenge-of-the-runelords-bestiary/quoroc.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"revenge_of_the_runelords_bestiary__quoroc","sourcePack":"pf2e.revenge-of-the-runelords-bestiary","sourceDocId":"EIExtvIGAnR420JB"}}}