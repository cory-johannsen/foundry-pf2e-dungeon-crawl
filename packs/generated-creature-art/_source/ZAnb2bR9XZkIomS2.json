.7ydMyqCO1oh7cHUR"},{"_id":"McH1gJqQMQRVSagF","img":"systems/pf2e/icons/default-icons/melee.svg","name":"Pewter Mug","sort":700000,"system":{"attack":{"value":""},"attackEffects":{"value":[]},"bonus":{"value":3},"damageRolls":{"0":{"damage":"1d4+3","damageType":"bludgeoning"}},"description":{"value":""},"publication":{"license":"OGL","remaster":false,"title":""},"range":null,"rules":[],"slug":null,"traits":{"rarity":"common","value":["thrown-10"]},"_migration":{"version":0.959,"previous":null}},"type":"melee","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!ZAnb2bR9XZkIomS2.McH1gJqQMQRVSagF"},{"_id":"eAaIdI0UJUrcmPzC","img":"systems/pf2e/icons/actions/Passive.webp","name":"Bar Brawler","sort":800000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>The barkeep has been in enough bar fights to know how to throw a few punches. When fighting in their bar and making a nonlethal attack, the barkeep gains a +1 circumstance bonus to attack rolls and deals an additional 1d4 damage.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[{"key":"RollOption","option":"bar-brawler","toggleable":true},{"key":"FlatModifier","predicate":["bar-brawler","item:trait:nonlethal"],"selector":"attack","type":"circumstance","value":1},{"diceNumber":1,"dieSize":"d4","key":"DamageDice","predicate":["bar-brawler","item:trait:nonlethal"],"selector":"strike-damage"}],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!ZAnb2bR9XZkIomS2.eAaIdI0UJUrcmPzC"},{"_id":"wvyx4nEskJ9Imojt","img":"systems/pf2e/icons/actions/ThreeActions.webp","name":"Barkeep's Advice","sort":900000,"system":{"actionType":{"value":"action"},"actions":{"value":3},"category":"offensive","description":{"value":"<p><strong>Frequency</strong> once per day</p>\n<hr />\n<p><strong>Effect</strong> The barkeep gives some pertinent advice to a single creature other than themself. For 24 hours, when that creature fails a skill check or saving throw, they can recall this advice and reroll the check, using the second result instead. Once that creature uses this ability, its effect ends.</p>\n<p>A creature that receives the Barkeep's Advice is temporarily immune to the ability for 1 month.</p>"},"frequency":{"max":1,"per":"day","value":1},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":["auditory","fortune","linguistic","mental"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!ZAnb2bR9XZkIomS2.wvyx4nEskJ9Imojt"},{"_id":"Rpv1wLy0PVmx5FE6","img":"systems/pf2e/icons/default-icons/lore.svg","name":"Alcohol Lore","sort":1000000,"system":{"description":{"value":""},"mod":{"value":9},"proficient":{"value":0},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"_migration":{"version":0.959,"previous":null}},"type":"lore","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!ZAnb2bR9XZkIomS2.Rpv1wLy0PVmx5FE6"}],"name":"Barkeep","system":{"abilities":{"cha":{"mod":3},"con":{"mod":2},"dex":{"mod":0},"int":{"mod":0},"str":{"mod":3},"wis":{"mod":1}},"attributes":{"ac":{"details":"","value":14},"allSaves":{"value":""},"hp":{"details":"","max":25,"temp":0,"value":25},"speed":{"otherSpeeds":[],"value":25}},"details":{"blurb":"","languages":{"details":"","value":["common"]},"level":{"value":1},"privateNotes":"","publicNotes":"<p>Barkeeps are often friends and mentors within a community, lending an ear while supplying libations. The best barkeeps have some talent for storytelling and passing on valuable advice.</p>\n<hr />\n<p>Countless adventures begin in a tavern or a pub. Maybe it's because such places attract the risk-prone, or maybe it's because everyone needs a little liquid courage before they decide to take on a group of rampaging ogres.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Gamemastery Guide"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":6,"senses":[]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":7},"reflex":{"saveDetail":"","value":3},"will":{"saveDetail":"","value":6}},"skills":{"athletics":{"base":6},"deception":{"base":6},"diplomacy":{"base":8},"performance":{"base":6},"society":{"base":5},"thievery":{"base":3}},"traits":{"rarity":"common","size":{"value":"med"},"value":["human","humanoid"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.npc-gallery.Actor.6IADTZHYowxObqAk"},"effects":[],"_key":"!actors!ZAnb2bR9XZkIomS2","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/npc-gallery/barkeep.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"npc_gallery__barkeep","sourcePack":"pf2e.npc-gallery","sourceDocId":"6IADTZHYowxObqAk"}}}