,"immunities":[{"type":"bleed"},{"type":"paralyzed"},{"type":"poison"},{"type":"sleep"}],"speed":{"otherSpeeds":[{"type":"fly","value":50}],"value":0}},"details":{"blurb":"","languages":{"details":"","value":[]},"level":{"value":3},"privateNotes":"","publicNotes":"<p>Zephyr hawks drift among the currents of the Plane of Air in great flocks. They delight in riding the air currents with no destination in mind.</p>\n<hr />\n<p>Hailing from the Plane of Air, these beings appear in a variety of sizes and shapes. They're noted for being elusive, swift, and often difficult to detect due to being composed primarily of air.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":7,"senses":[{"type":"darkvision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":6},"reflex":{"saveDetail":"","value":13},"will":{"saveDetail":"","value":7}},"skills":{"acrobatics":{"base":13},"stealth":{"base":11}},"traits":{"rarity":"common","size":{"value":"sm"},"value":["air","elemental"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-monster-core.Actor.sAfjpjAS56jtrUbi"},"effects":[],"_key":"!actors!k6vo4NijUkQPRRra","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/shared/zephyr-hawk.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"shared__pathfinder_monster_core__zephyr_hawk","sourcePack":"pf2e.pathfinder-monster-core","sourceDocId":"sAfjpjAS56jtrUbi"}}}