unteract]]{+10} counteract modifier.</p>\n<p>The skulker's possessions are left in a pile where they died.</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":null,"traits":{"rarity":"common","value":["darkness","occult"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!msGtOi4VdFCtyuNc.hIxE6LMA92SPk1eC"},{"_id":"OVmDA2DweiDfmQwN","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.I0HYG0ctCLP5JRsW"},"img":"systems/pf2e/icons/actions/Passive.webp","name":"Light Blindness","sort":700000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.LightBlindness]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":"light-blindness","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!msGtOi4VdFCtyuNc.OVmDA2DweiDfmQwN"},{"_id":"UipChONJlSGScaQZ","img":"systems/pf2e/icons/actions/Passive.webp","name":"Sneak Attack","sort":800000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>The caligni skulker deals 1d6 extra precision damage to @UUID[Compendium.pf2e.conditionitems.Item.AJh5ex99aV6VTggg]{Off-Guard} creatures.</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[{"category":"precision","diceNumber":1,"dieSize":"d6","key":"DamageDice","predicate":["target:condition:off-guard"],"selector":"strike-damage"},{"key":"RollOption","label":"PF2E.SpecificRule.TOTMToggle.OffGuard","option":"target:condition:off-guard","toggleable":"totm"}],"slu