nitems.Item.j91X7x0XSomq8d60]{Prone} enemy. If it hits, in addition to dealing damage, the hyaenodon Strides up to 10 feet, dragging the enemy along.</p>"},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!Q4OPfizCePLKxDWL.fX3ZS6kW7CqzkJuu"},{"_id":"pYg2FGHWnoS7Le78","img":"systems/pf2e/icons/actions/Passive.webp","name":"Pack Attack","sort":400000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>The hyaenodon deals an extra 1d6 damage to any creature within reach of at least two of the hyaenodon's allies.</p>"},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[{"domain":"damage","key":"RollOption","option":"pack-attack","toggleable":true},{"diceNumber":1,"dieSize":"d6","key":"DamageDice","predicate":["pack-attack"],"selector":"strike-damage"}],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!Q4OPfizCePLKxDWL.pYg2FGHWnoS7Le78"},{"_id":"YWBW2zZbIggEH4rW","img":"systems/pf2e/icons/actions/OneAction.webp","name":"Knockdown","sort":500000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Knockdown]</p>"},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!Q4OPfizCePLKxDWL.YWBW2zZbIggEH4rW"}],"name":"Hyaenodon","system":{"abilities":{"cha":{"mod":-2},"con":{"mod":3},"dex":{"mod":3},"int":{"mod":-4},"str":{"mod":5},"wis":{"mod":2}},"attributes":{"ac":{"details":"","value":18},"allSaves":{"value":""},"hp":{"details":"","max":45,"temp":0,"value":45},"speed":{"otherSpeeds":[],"value":40}},"details":{"blurb":"","languages":{"details":"","value":[]},"level":{"value":3},"privateNotes":"","publicNotes":"<p>Hyaenodons are ferocious primeval creatures that resemble hyenas. Looming, shaggy-furred animals nearly the size of a horse, hyaenodons are truly formidable predators to be reckoned with, due both to their size and to their flesh-shearing jaws. Hyaenodons prey on small horses, camels, and even young rhinoceroses. Kholo clans find these creatures particularly useful as mounts and guardians.</p>\n<hr />\n<p>Hyenas are pack-hunting scavengers known for their unnerving, laughterlike cries. The most well-known hyenas are the socially gregarious spotted hyenas, who travel in packs and work together to hunt or drive off larger creatures. Hyenas are typically nocturnal creatures who scavenge meat, insects, and fruit, though they aren't above supplementing their carrion diets with fresh prey.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":9,"senses":[{"type":"low-light-vision"},{"acuity":"imprecise","range":30,"type":"scent"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":10},"reflex":{"saveDetail":"","value":8},"will":{"saveDetail":"","value":7}},"skills":{"acrobatics":{"base":8},"athletics":{"base":12},"stealth":{"base":8}},"traits":{"rarity":"common","size":{"value":"lg"},"value":["animal"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-monster-core.Actor.1Qqu3b4J4aJYEQOX"},"effects":[],"_key":"!actors!Q4OPfizCePLKxDWL","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-monster-core/hyaenodon.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pathfinder_monster_core__hyaenodon","sourcePack":"pf2e.pathfinder-monster-core","sourceDocId":"1Qqu3b4J4aJYEQOX"}}}