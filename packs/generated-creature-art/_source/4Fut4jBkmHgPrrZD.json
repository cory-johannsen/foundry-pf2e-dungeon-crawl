n.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder NPC Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":3,"senses":[]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":4},"reflex":{"saveDetail":"","value":7},"will":{"saveDetail":"","value":3}},"skills":{"athletics":{"base":3},"deception":{"base":3},"diplomacy":{"base":3},"stealth":{"base":5}},"traits":{"rarity":"common","size":{"value":"med"},"value":["human","humanoid"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-npc-core.Actor.d47PtIdozWwSOtur"},"effects":[],"_key":"!actors!4Fut4jBkmHgPrrZD","prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-npc-core/beggar.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pathfinder_npc_core__beggar","sourcePack":"pf2e.pathfinder-npc-core","sourceDocId":"d47PtIdozWwSOtur"}}}