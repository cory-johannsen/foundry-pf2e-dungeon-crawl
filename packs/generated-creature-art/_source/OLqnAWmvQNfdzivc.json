s they don't want spattered with acid.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder #164: Hands of the Devil"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":16,"senses":[{"type":"darkvision"},{"acuity":"imprecise","range":30,"type":"scent"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":20},"reflex":{"saveDetail":"","value":15},"will":{"saveDetail":"","value":16}},"skills":{"athletics":{"base":18,"special":[{"base":22,"label":"to High Jump or Long Jump","predicate":[{"or":["action:long-jump","action:high-jump"]}]}]},"intimidation":{"base":15},"survival":{"base":16}},"traits":{"rarity":"uncommon","size":{"value":"lg"},"value":["aberration","chaotic"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.abomination-vaults-bestiary.Actor.T6vOuhM1KV5Fr75F"},"effects":[],"_key":"!actors!OLqnAWmvQNfdzivc","prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/abomination-vaults-bestiary/gibtanius.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"abomination_vaults_bestiary__gibtanius","sourcePack":"pf2e.abomination-vaults-bestiary","sourceDocId":"T6vOuhM1KV5Fr75F"}}}