structive, but often not intentionally so; just as water can bring life to mortals in need, its waves can pound shores and rains can flood cities. Water elementals are similarly difficult to predict.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":22,"senses":[{"type":"darkvision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":21},"reflex":{"saveDetail":"","value":22},"will":{"saveDetail":"","value":19}},"skills":{"athletics":{"base":23},"stealth":{"base":23}},"traits":{"rarity":"common","size":{"value":"huge"},"value":["aquatic","elemental","water"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-monster-core.Actor.R427CMT90S7fv7MY"},"effects":[],"_key":"!actors!KSoYBHxG7HrpEO2r","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/shared/elemental-tsunami.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"shared__pathfinder_monster_core__elemental_tsunami","sourcePack":"pf2e.pathfinder-monster-core","sourceDocId":"R427CMT90S7fv7MY"}}}