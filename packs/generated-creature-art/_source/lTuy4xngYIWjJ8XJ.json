x":45,"temp":0,"value":45},"speed":{"otherSpeeds":[{"type":"fly","value":40}],"value":20}},"details":{"blurb":"","languages":{"details":"","value":[]},"level":{"value":3},"privateNotes":"","publicNotes":"<p>Giant wasps are much more dangerous but less common than their smaller kin, and—to the relief of those who encounter them—they tend to be solitary.</p>\n<hr />\n<p>While the common wasp poses little threat to a hardy adventurer aside from an uncomfortable sting, a large and aggressive swarm of these territorial insects—to say nothing of their oversized kin—can lay low an entire party of heroes. The wasps represented here are of the common variety, also known as yellow jackets, but many other sorts of dangerous wasps exist, such as a Garundi variant that swarms in such great numbers that it can decimate entire villages.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":8,"senses":[{"type":"darkvision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":9},"reflex":{"saveDetail":"","value":11},"will":{"saveDetail":"","value":6}},"skills":{"acrobatics":{"base":11},"athletics":{"base":9}},"traits":{"rarity":"common","size":{"value":"lg"},"value":["animal"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-monster-core.Actor.6aaBmiOgqZ5h2IhW"},"effects":[],"_key":"!actors!lTuy4xngYIWjJ8XJ","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-monster-core/giant-wasp.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pathfinder_monster_core__giant_wasp","sourcePack":"pf2e.pathfinder-monster-core","sourceDocId":"6aaBmiOgqZ5h2IhW"}}}