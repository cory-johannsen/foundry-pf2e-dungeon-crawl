ug":"coven","traits":{"rarity":"common","value":["mental","occult"]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!5H1tZMuAYzi7reoe.yxb37QHZ4RqNpk63"},{"_id":"v6OFzpj6ZUBHYYW9","img":"systems/pf2e/icons/actions/Passive.webp","name":"Hungersight","sort":600000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"interaction","description":{"value":"<p>A weredigo can precisely sense peckish creatures.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":["primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!5H1tZMuAYzi7reoe.v6OFzpj6ZUBHYYW9"},{"_id":"MXZvzCgypC6fZYM6","img":"systems/pf2e/icons/actions/TwoActions.webp","name":"Reduce Options","sort":700000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p><strong>Requirements</strong> The weredigo is adjacent to two creatures that can't decide where to get brunch.</p>\n<hr />\n<p><strong>Effect</strong> The weredigo makes two fork Strikes and two knife Strikes against one of the adjacent creatures. These attacks don't count toward the weredigo's multiple attack penalty.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":["curse","mental","primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!5H1tZMuAYzi7reoe.MXZvzCgypC6fZYM6"},{"_id":"4XrSYIpCKfBITNa3","img":"systems/pf2e/icons/actions/Passive.webp","name":"Weredigo Torment","sort":800000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","