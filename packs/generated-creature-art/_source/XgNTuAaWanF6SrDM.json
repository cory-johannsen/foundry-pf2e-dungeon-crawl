2e/icons/actions/Passive.webp","name":"Greater Darkvision","sort":500000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"interaction","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.GreaterDarkvision]</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary"},"rules":[],"slug":"greater-darkvision","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!XgNTuAaWanF6SrDM.4LeRt1l6t3cdOZzq"},{"_id":"uLKGOD24rA4zKuVY","img":"systems/pf2e/icons/actions/Passive.webp","name":"Otherworldly Mind","sort":600000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>Whenever a creature targets the pup with a mental effect, that creature takes @Damage[2d6[mental]] damage (@Check[will|dc:20|basic] save). On a critical failure, it also becomes @UUID[Compendium.pf2e.conditionitems.Item.yblD8fOR1J8rDwEQ]{Confused} for 1 round.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":["mental"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!XgNTuAaWanF6SrDM.uLKGOD24rA4zKuVY"},{"_id":"N3LEi8X040wdsdnY","img":"systems/pf2e/icons/actions/Passive.webp","name":"Ripping Gaze","sort":700000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>15 feet. The pup of Tindalos's eyes glow balefully, causing painful but bloodless wounds to rip open in the body of a creature that meets its awful gaze. When a creature ends its turn in the aura's emanation, it takes @Damage[1d8[slashing]] damage (@Check[fortitude|dc:20|basic] save). A creature that critically succeeds at its save is temporarily immune for 24 hours.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[{"key":"Aura","radius":15,"slug":"ripping-gaze","traits":["occult","visual"]}],"slug":null,"traits":{"rarity":"common","value":["aura","occult","visual"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!XgNTuAaWanF6SrDM.N3LEi8X040wdsdnY"},{"_id":"DieNPV4rufI5UUlU","img":"systems/pf2e/icons/actions/Passive.webp","name":"Vulnerable to Curved Space","sort":800000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>When a pup of Tindalos is not adjacent to a structural angle of 90° (or more acute), its resistance to physical damage is suppressed and it becomes @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1}. It can't recover from this sickened condition, but the condition ends automatically once the pup is again adjacent to a suitable angle.</p>\n<p>@UUID[Compendium.pf2e.bestiary-effects.Item.V60TWjo1G1r5ZtPM]{Effect: Vulnerable to Curved Space}</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[{"key":"Resistance","predicate":[{"not":"self:effect:vulnerable-to-curved-space"}],"type":"physical","value":5}],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!XgNTuAaWanF6SrDM.DieNPV4rufI5UUlU"},{"_id":"I7JAhXDrXyaw9v8N","img":"systems/pf2e/icons/actions/OneAction.webp","name":"Angled Entry","sort":900000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>The pup of Tindalos casts a 4th-rank @UUID[Compendium.pf2e.spells-srd.Item.VlNcjmYyu95vOUe8]{Translocate} spell, but it must transport itself into a space adjacent to an angle of 90º (or more acute) in the structure or environment around it. For example, it could teleport to a space adjacent to a wall (using the angle between the wall and floor) or a corner in a room, or adjacent to a sizable tree growing straight up out of the ground, but not to a flat plain or a room with only curved corners and edges.</p>\n<p>Once per day, the pup of Tindalos can use this ability to plane shift to or from the Dimension of Time, with the same restrictions on what angles it can appear next to.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!XgNTuAaWanF6SrDM.I7JAhXDrXyaw9v8N"}],"name":"Pup of Tindalos","system":{"abilities":{"cha":{"mod":1},"con":{"mod":1},"dex":{"mod":4},"int":{"mod":4},"str":{"mod":3},"wis":{"mod":3}},"attributes":{"ac":{"details":"","value":19},"allSaves":{"value":""},"hp":{"details":"","max":30,"temp":0,"value":30},"immunities":[{"type":"controlled"},{"type":"emotion"}],"resistances":[{"type":"mental","value":5},{"type":"poison","value":5}],"speed":{"otherSpeeds":[{"type":"fly","value":30}],"value":30}},"details":{"blurb":"Variant hound of Tindalos","languages":{"details":"","value":["aklo"]},"level":{"value":3},"privateNotes":"","publicNotes":"","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Society Special #3-99: Fate in the Future"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":10,"senses":[{"type":"greater-darkvision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":6},"reflex":{"saveDetail":"","value":11},"will":{"saveDetail":"","value":8}},"skills":{"acrobatics":{"base":10},"athletics":{"base":8},"occultism":{"base":9},"stealth":{"base":10},"survival":{"base":8,"special":[{"base":10,"label":"to Track","predicate":["action:track"]}]}},"traits":{"rarity":"rare","size":{"value":"sm"},"value":["aberration","evil","time"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pfs-season-3-bestiary.Actor.9FgyBdbHxwMYdGAt"},"effects":[],"_key":"!actors!XgNTuAaWanF6SrDM","prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pfs-season-3-bestiary/pup-of-tindalos-lob.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pfs_season_3_bestiary__pup_of_tindalos","sourcePack":"pf2e.pfs-season-3-bestiary","sourceDocId":"9FgyBdbHxwMYdGAt"}}}