oreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.equipment-srd.Item.plplsXJsqrdqNQVI"},"img":"icons/commodities/treasure/brooch-jeweled-green.webp","name":"Religious Symbol (Wooden) of Pharasma","sort":400000,"system":{"baseItem":null,"bulk":{"value":0.1},"containerId":null,"description":{"value":"<p>This piece of wood or silver is emblazoned with an image representing a deity. Some divine spellcasters, such as clerics, can use a religious symbol of their deity as a divine focus to use certain abilities and cast some spells. A religious symbol must be held in one hand to use it.</p>"},"equipped":{"carryType":"worn","inSlot":true,"invested":null},"hardness":0,"hp":{"max":0,"value":0},"level":{"value":0},"material":{"grade":null,"type":null},"price":{"value":{"sp":1}},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Core Rulebook"},"quantity":1,"rules":[],"size":"med","slug":"religious-symbol-wooden","traits":{"rarity":"common","value":[]},"usage":{"value":"held-in-one-hand"},"_migration":{"version":0.959,"previous":null}},"type":"equipment","effects":[],"_key":"!actors.items!qqzSk3it3N3fdMLW.4mQUcJRfogdhtD4e"},{"_id":"Dsv6gk01qHhDFfUp","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.equipment-srd.Item.Du05UxCyCM0ZWH8z"},"img":"icons/consumables/potions/potion-bottle-labeled-medicine-capped-red-black.webp","name":"Oil (1 pint)","sort":500000,"system":{"baseItem":null,"bulk":{"value":0},"category":"oil","containerId":null,"damage":null,"description":{"value":"<p>You can use oil to fuel lanterns, but you can also set a pint of oil aflame and throw it. You must first spend an Interact action preparing the oil, then throw it with another action as a ranged attack. If you hit, it splatters on the creature or in a single 5-foot square you target. You must succeed at a @Check[flat|dc:10] for the oil to ignite successfully when it hits. If the oil ignites, the target takes 1d6 fire damage.</p>"},"equipped":{"carryType":"worn","handsHeld":0},"hardness":0,"hp":{"max":0,"value":0},"level":{"value":0},"material":{"grade":null,"type":null},"price":{"value":{"cp":1}},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Core Rulebook"},"quantity":2,"rules":[],"size":"med","slug":"oil-1-pint","traits":{"rarity":"common","value":[]},"usage":{"value":"held-in-one-hand"},"uses":{"autoDestroy":true,"max":1,"value":1},"_migration":{"version":0.959,"previous":null}},"type":"consumable","effects":[],"_key":"!actors.items!qqzSk3it3N3fdMLW.Dsv6gk01qHhDFfUp"},{"_id":"C9BvM6sI4AN0SssQ","flags":{"pf2e":{"linkedWeapon":"iCIavuhoO4Uam2Vj"}},"img":"systems/pf2e/icons/default-icons/melee.svg","name":"Shovel","sort":600000,"system":{"attackEffects":{"value":[]},"bonus":{"value":9},"damageRolls":{"hlzfkd77tbrcxg7qw85x":{"damage":"1d4+4","damageType":"bludgeoning"}},"description":{"value":""},"publication":{"license":"ORC","remaster":true,"title":""},"range":null,"rules":[],"slug":null,"traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"melee","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!qqzSk3it3N3fdMLW.C9BvM6sI4AN0SssQ"},{"_id":"GPuyJgPMttZv9rs8","img":"systems/pf2e/icons/default-icons/melee.svg","name":"Fist","sort":700000,"system":{"attackEffects":{"value":[]},"bonus":{"value":9},"damageRolls":{"0":{"damage":"1d4+4","damageType":"bludgeoning"}},"description":{"value":""},"publication":{"license":"ORC","remaster":true,"title":""},"range":null,"rules":[],"slug":null,"traits":{"value":["agile","nonlethal","unarmed"]},"_migration":{"version":0.959,"previous":null}},"type":"melee","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!qqzSk3it3N3fdMLW.GPuyJgPMttZv9rs8"},{"_id":"ammC8wH7C165yxrp","img":"systems/pf2e/icons/actions/TwoActions.webp","name":"Light in the Dark","sort":800000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p><strong>Requirements</strong> The gravedigger is holding a @UUID[Compendium.pf2e.equipment-srd.Item.QrNvP9SgnK9DrerA]{bull's-eye lantern} in one hand and their religious symbol in the other, and the lantern contains @UUID[Compendium.pf2e.equipment-srd.Item.Du05UxCyCM0ZWH8z]{oil}</p><hr /><p><strong>Effect</strong> The gravedigger recites a brief chant to ignite their lantern with vital energy. Each undead creature in a @Template[type:line|distance:15] takes @Damage[3d6[vitality]|options:area-damage] damage with a @Check[fortitude|dc:14|basic|options:area-effect] save. This action uses all remaining oil in the bull's-eye lantern.</p>"},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":null,"traits":{"value":["concentrate","divine","manipulate","vitality"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!qqzSk3it3N3fdMLW.ammC8wH7C165yxrp"},{"_id":"2m3sOYaFmlCapCZm","img":"systems/pf2e/icons/default-icons/lore.svg","name":"Graveyard Lore","sort":900000,"system":{"description":{"value":""},"mod":{"value":4},"proficient":{"value":0},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":null,"traits":{},"_migration":{"version":0.959,"previous":null}},"type":"lore","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!qqzSk3it3N3fdMLW.2m3sOYaFmlCapCZm"}],"name":"Gravedigger","system":{"abilities":{"cha":{"mod":0},"con":{"mod":3},"dex":{"mod":1},"int":{"mod":0},"str":{"mod":4},"wis":{"mod":2}},"attributes":{"ac":{"details":"","value":15},"allSaves":{"value":""},"hp":{"details":"","max":20,"temp":0,"value":20},"resistances":[{"type":"void","value":2}],"speed":{"otherSpeeds":[],"value":25}},"details":{"blurb":"","languages":{"details":"","value":["common"]},"level":{"value":1},"privateNotes":"","publicNotes":"<p>An often-overlooked group of laborers, gravediggers have a reputation for being as quiet and grim as their workplace. They're usually strong and tough from their long hours of backbreaking labor, and they tend to have a unique perspective on life and death.</p><hr /><p>Society is built upon the backs of laborers.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder NPC Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":6,"senses":[]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":8},"reflex":{"saveDetail":"","value":4},"will":{"saveDetail":"","value":7}},"skills":{"athletics":{"base":7},"religion":{"base":5},"stealth":{"base":4}},"traits":{"rarity":"common","size":{"value":"med"},"value":["human","humanoid"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-npc-core.Actor.0t2jNg5tpwWbCYx4"},"effects":[],"_key":"!actors!qqzSk3it3N3fdMLW","prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-npc-core/gravedigger.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pathfinder_npc_core__gravedigger","sourcePack":"pf2e.pathfinder-npc-core","sourceDocId":"0t2jNg5tpwWbCYx4"}}}