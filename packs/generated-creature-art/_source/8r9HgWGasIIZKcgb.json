oud must attempt a @Check[fortitude|dc:16] save or become @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1}. The glowing mucus remains in the area for 1 minute, and any creature that ends its turn in the area must succeed at a @Check[fortitude|dc:13] save or become @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1}.</p>"},"frequency":{"max":1,"per":"day","value":1},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!8r9HgWGasIIZKcgb.vmyBkhvE34HW6vpl"}],"name":"Vampire Squid","system":{"abilities":{"cha":{"mod":-2},"con":{"mod":0},"dex":{"mod":3},"int":{"mod":-4},"str":{"mod":0},"wis":{"mod":3}},"attributes":{"ac":{"details":"","value":16},"allSaves":{"value":""},"hp":{"details":"","max":15,"temp":0,"value":15},"resistances":[{"type":"cold","value":5}],"speed":{"otherSpeeds":[{"type":"swim","value":25}],"value":0}},"details":{"blurb":"","languages":{"details":"","value":[]},"level":{"value":0},"privateNotes":"","publicNotes":"<p>Vampire squid are neither undead nor blood drinkers. Their name is instead inspired by their red eyes and the dark, cloak-like webbing between their arms. Living in the lightless depths of the ocean, the vampire squid can eject a cloud of bioluminescent mucus that nauseates predators.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary 2"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":7,"senses":[{"type":"darkvision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":4},"reflex":{"saveDetail":"","value":8},"will":{"saveDetail":"","value":6}},"skills":{"athletics":{"base":4},"stealth":{"base":7}},"traits":{"rarity":"common","size":{"value":"sm"},"value":["animal","aq