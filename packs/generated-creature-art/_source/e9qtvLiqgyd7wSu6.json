ue":"10 minutes"},"level":{"value":9},"location":{"value":"hTqMUAAnd9iTtvQW"},"publication":{"license":"OGL","remaster":false,"title":""},"range":{"value":"touch"},"requirements":"","rules":[],"slug":"freedom-of-movement","target":{"value":"1 creature touched"},"time":{"value":"2"},"traits":{"rarity":"common","traditions":["arcane","divine","primal"],"value":["concentrate","manipulate"]},"_migration":{"version":0.959,"previous":null}},"type":"spell","effects":[],"_key":"!actors.items!e9qtvLiqgyd7wSu6.k8jXY7QubcoSOAYR"},{"_id":"fh90HLxqhj0ijf1r","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.spells-srd.Item.uqlxMQQeSGWEVjki"},"img":"systems/pf2e/icons/spells/true-seeing.webp","name":"True Seeing (Constant)","sort":300000,"system":{"area":null,"cost":{"value":""},"counteraction":true,"damage":{},"defense":null,"description":{"value":"<p>You see things within 60 feet as they actually are. The GM rolls a secret counteract check against any illusion or transmutation in the area, but only for the purpose of determining whether you see through it (for instance, if the check succeeds against a polymorph spell, you can see the creature's true form, but you don't end the polymorph spell).</p>"},"duration":{"sustained":false,"value":"10 minutes"},"level":{"value":8},"location":{"value":"hTqMUAAnd9iTtvQW"},"publication":{"license":"OGL","remaster":false,"title":""},"range":{"value":""},"requirements":"","rules":[],"slug":"true-seeing","target":{"value":""},"time":{"value":"2"},"traits":{"rarity":"common","traditions":["arcane","divine","occult","primal"],"value":["concentrate","manipulate","revelation"]},"_migration":{"version":0.959,"previous":null}},"type":"spell","effects":[],"_key":"!actors.items!e9qtvLiqgyd7wSu6.fh90HLxqhj0ijf1r"},{"_id":"l25YrJUMqQDtE3NT","img":"systems/pf2e/icons/default-icons/melee.svg","name":"Jaws","sort":400000,"system":{"attack":{"value":""},"attackEffects":{"custom":"","value":["taiga-