d7wSu6.mcsK2cK4pMrDIfZJ"},{"_id":"g41jvLpQ6exKQBgd","img":"systems/pf2e/icons/actions/Passive.webp","name":"Spines","sort":1200000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>Any creature that makes a melee attack against a taiga linnorm is stabbed by the taiga linnorm's spines and takes @Damage[1d6[piercing]] damage per attack. A melee weapon with reach protects the user against these spines.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!e9qtvLiqgyd7wSu6.g41jvLpQ6exKQBgd"},{"_id":"kli2QsKUO2VSz2oy","img":"systems/pf2e/icons/actions/TwoActions.webp","name":"Breath Weapon","sort":1300000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>The taiga linnorm breathes a @Template[cone|distance:60] of electrified vapor, dealing @Damage[20d6[electricity]|options:area-damage] damage to creatures in the area (@Check[reflex|dc:41|basic|options:area-effect] save). The electrified mist persists for [[/gmr 1d4 #rounds]]{1d4 rounds}, dealing @Damage[6d6[electricity]] damage (@Check[reflex|dc:41|basic] save) to each creature that ends its turn in the mist.</p>\n<p>The taiga linnorm can't use Breath Weapon again for [[/gmr 1d4 #Recharge Breath Weapon]]{1d4 rounds}.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":["electricity","primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!e9qtvLiqgyd7wSu6.kli2QsKUO2VSz2oy"},{"_id":"qCZyXHHj5OMACPYY","img":"systems/pf2e/icons/actions/Passive.webp","name":"Taiga Linnorm Venom","sort":1400000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p><strong>Saving Throw</strong> @Check[fortitude|dc:42]</p>\n<p><strong>Maximum Duration</strong> 10 rounds</p>\n<p><strong>Stage 1</strong> @Damage[7d6[electricity]] damage and @UUID[Compendium.pf2e.conditionitems.Item.4D2KBtexWXa6oUMR]{Drained 1} (1 round)</p>\n<p><strong>Stage 2</strong> @Damage[10d6[electricity]] damage and @UUID[Compendium.pf2e.conditionitems.Item.4D2KBtexWXa6oUMR]{Drained 2} (1 round)</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":"taiga-linnorm-venom","traits":{"rarity":"common","value":["electricity","poison"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!e9qtvLiqgyd7wSu6.qCZyXHHj5OMACPYY"},{"_id":"r7aL4DHJpi1R2n6Z","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.i18TlebMzwONyPhI"},"img":"systems/pf2e/icons/actions/FreeAction.webp","name":"Improved Grab","sort":1500000,"system":{"actionType":{"value":"free"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ImprovedGrab]</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary"},"rules":[],"slug":"improved-grab","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!e9qtvLiqgyd7wSu6.r7aL4DHJpi1R2n6Z"}],"name":"Taiga Linnorm","system":{"abilities":{"cha":{"mod":7},"con":{"mod":8},"dex":{"mod":6},"int":{"mod":-2},"str":{"mod":10},"wis":{"mod":6}},"attributes":{"ac":{"details":"","value":44},"allSaves":{"value":"+1 status to all saves vs. magic"},"hp":{"details":"regeneration 15 (deactivated by cold iron)","max":385,"temp":0,"value":385},"immunities":[{"type":"curse"},{"type":"electricity"},{"type":"paralyzed"},{"type":"sleep"}],"speed":{"otherSpeeds":[{"type":"fly","value":100},{"type":"swim","value":50}],"value":40},"weaknesses":[{"type":"cold-iron","value":15}]},"details":{"blurb":"","languages":{"details":"","value":["aklo","draconic","fey"]},"level":{"value":19},"privateNotes":"","publicNotes":"<p>Taiga linnorms are covered in hundreds of quill-like black spines as sharp as spears. Wise hunters native to linnorm-infested lands know to watch for spines stuck in the bark of conifers-a sure sign that a taiga linnorm has recently passed through. Sometimes this means of tracking isn't enough to avoid an encounter, however; taiga linnorms, like their tarn and tor brethren, are skilled stalkers. They prefer to lurk in half-frozen bogs or swampy marshlands with their heads poking just above the water's surface, ever watchful for unwary prey.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary 2"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":33,"senses":[{"type":"darkvision"},{"acuity":"imprecise","range":60,"type":"scent"},{"acuity":"precise","range":60,"type":"truesight"}]},"resources":{"focus":{"max":1,"value":1}},"saves":{"fortitude":{"saveDetail":"","value":35},"reflex":{"saveDetail":"","value":31},"will":{"saveDetail":"","value":29}},"skills":{"acrobatics":{"base":33},"athletics":{"base":37},"stealth":{"base":35}},"traits":{"rarity":"uncommon","size":{"value":"grg"},"value":["chaotic","dragon","evil"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-bestiary-2.Actor.NAy7eUqFI8tGm3Ug"},"effects":[],"_key":"!actors!e9qtvLiqgyd7wSu6","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/