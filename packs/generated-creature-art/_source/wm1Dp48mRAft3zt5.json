2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!wm1Dp48mRAft3zt5.VhwoW1Wd9SqC4MVO"},{"_id":"4s0p8fCnssqfycUf","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.uJSseLa57HZYSMUu"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Swallow Whole","sort":600000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>Large, @Damage[(1d10+7)[bludgeoning]], Rupture 21</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.SwallowWhole]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":"swallow-whole","traits":{"rarity":"common","value":["attack"]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!wm1Dp48mRAft3zt5.4s0p8fCnssqfycUf"},{"_id":"765hQtSimhXMwS7m","img":"systems/pf2e/icons/actions/OneAction.webp","name":"Wrap in Coils","sort":700000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p><strong>Requirements</strong> A Large or smaller creature is @UUID[Compendium.pf2e.conditionitems.Item.kWc1fhmv9LBiTuei]{Grabbed} or @UUID[Compendium.pf2e.conditionitems.Item.VcDeM8A5oI6VqhbM]{Restrained} in the giant anaconda's jaws.</p>\n<hr />\n<p><strong>Effect</strong> The giant anaconda moves the creature into its coils, freeing its jaws to make attacks, then uses Greater Constrict against the creature. The giant anaconda's coils can hold as many creatures as will fit in its space.</p>"},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":["attack"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!wm1Dp48mRAft3zt5.765hQtSimhXMwS7m"},{"_id":"kfjRR8MHRHoxgCkF","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.Tkd8sH4pwFIPzqTr"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Grab","sort":800000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Grab]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":"grab","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!wm1Dp48mRAft3zt5.kfjRR8MHRHoxgCkF"},{"_id":"eOgrqVcnppzRiPms","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.t6cx9FOODmeZQNYl"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Push 10 feet","sort":900000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Push]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":"push","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!wm1Dp48mRAft3zt5.eOgrqVcnppzRiPms"}],"name":"Giant Anaconda","system":{"abilities":{"cha":{"mod":-2},"con":{"mod":6},"dex":{"mod":3},"int":{"mod":-4},"str":{"mod":7},"wis":{"mod":3}},"attributes":{"ac":{"details":"","value":25},"allSaves":{"value":""},"hp":{"details":"","max":175,"temp":0,"value":175},"speed":{"otherSpeeds":[{"type":"climb","value":30},{"type":"swim","value":30}],"value":30}},"details":{"blurb":"","languages":{"details":"","value":[]},"level":{"value":8},"privateNotes":"","publicNotes":"<p>The monstrous giant anaconda is a constrictor snake capable of swallowing whole creatures as big as horses—to say nothing of their riders. Although novice bushwhackers watch out for snakes that might drop on them from the jungle canopy above, giant anacondas are most commonly encountered in ponds and rivers, where they feed on prey including manatees and capybaras. This hunting tactic allows anacondas to drown their prey while constricting it, reducing the chance of injuries while hunting. Despite lurid and sensational stories spread by adventurers, these snakes rarely attack humanoids.</p>\n<hr />\n<p>Snakes come in an array of forms, from jungle-dwelling constrictors that wrap around their prey to venomous vipers with deadly bites. Regardless, all snakes consume their prey whole by unhinging their jaws and using powerful muscles to move the food down their throats and into their stomachs.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":17,"senses":[{"type":"low-light-vision"},{"acuity":"imprecise","range":60,"type":"scent"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":20},"reflex":{"saveDetail":"","value":17},"will":{"saveDetail":"","value":15}},"skills":{"acrobatics":{"base":15},"athletics":{"base":21},"stealth":{"base":15},"survival":{"base":15}},"traits":{"rarity":"common","size":{"value":"huge"},"value":["animal"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-monster-core.Actor.XDNJSVxOOryeuN44"},"effects":[],"_key":"!actors!wm1Dp48mRAft3zt5","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-monster-core/giant-anaconda.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pathfinder_monster_core__giant_anaconda","sourcePack":"pf2e.pathfinder-monster-core","sourceDocId":"XDNJSVxOOryeuN44"}}}