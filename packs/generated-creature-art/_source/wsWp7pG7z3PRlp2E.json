e":null},"effects":[],"_key":"!actors.items!wsWp7pG7z3PRlp2E.B2rF8mguredueRbP"},{"_id":"x8pzzu8VRuRa5sdg","img":"systems/pf2e/icons/actions/Passive.webp","name":"Stench","sort":400000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"interaction","description":{"value":"<p>30 feet. A creature entering the aura or starting its turn in the aura must succeed at a @Check[fortitude|dc:30|options:area-effect,inflicts:sickened,inflicts:slowed] save or become @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1} (plus @UUID[Compendium.pf2e.conditionitems.Item.xYTAsEpcJE1Ccni3]{Slowed 1} for as long as it's sickened on a critical failure).</p>\n<p>While within the aura, affected creatures take a -2 circumstance penalty to saves against disease and to recover from the sickened condition. A creature that succeeds at its save is temporarily immune for 1 minute.</p>\n<p>@UUID[Compendium.pf2e.bestiary-effects.Item.wX9L6fbqVMLP05hn]{Effect: Stench}</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[{"key":"Aura","radius":30,"slug":"stench","traits":["olfactory"]}],"slug":null,"traits":{"value":["aura","olfactory"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!wsWp7pG7z3PRlp2E.x8pzzu8VRuRa5sdg"},{"_id":"XucZtbvC1QhYV0HW","img":"systems/pf2e/icons/actions/Reaction.webp","name":"Ferocity","sort":500000,"system":{"actionType":{"value":"reaction"},"actions":{"value":null},"category":"defensive","deathNote":true,"description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Ferocity]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":"ferocity","traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!wsWp7pG7z3PRlp2E.XucZtbvC1QhYV0HW"},{"_id":"VDW4W2k1N88INhBp","img":"systems/pf2e/icons/actions/TwoActions.webp","name":"Poison Breath","sort":600000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>The catoblepas breathes a @Template[cone|distance:60] of horrid fumes, dealing @Damage[13d6[poison]|options:area-damage] damage (@Check[fortitude|dc:32|basic|options:area-effect] save). The area of this cone is reduced to @Template[cone|distance:30]{30 feet} underwater. Targets that fail their saving throw also become @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1} (@UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 2} on a critical failure).</p>\n<p>The catoblepas can't use its Poison Breath again for [[/gmr 1d4 #Recharge Breath Weapon]]{1d4 rounds}.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"value":["poison","primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!wsWp7pG7z3PRlp2E.VDW4W2k1N88INhBp"},{"_id":"lPlAVVeLD4qqvZ8q","img":"systems/pf2e/icons/actions/ThreeActions.webp","name":"Trample","sort":700000,"system":{"actionType":{"value":"action"},"actions":{"value":3},"category":"offensive","description":{"value":"<p>Medium or smaller, hoof, @Check[reflex|dc:32|basic]</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.Trample]</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary"},"rules":[],"slug":"trample","traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!wsWp7pG7z3PRlp2E.lPlAVVeLD4qqvZ8q"}],"name":"Catoblepas","system":{"abilities":{"cha":{"mod":2},"con":{"mod":6},"dex":{"mod":4},"int":{"mod":-2},"str":{"mod":7},"wis":{"mod":4}},"attributes":{"ac":{"details":"","value":33},"allSaves":{"value":""},"hp":{"details":"","max":215,"temp":0,"value":215},"immunities":[{"type":"disease"},{"type":"poison"},{"type":"olfactory"}],"speed":{"otherSpeeds":[{"type":"swim","value":20}],"value":35}},"details":{"blurb":"","languages":{"details":"","value":["aklo"]},"level":{"value":12},"privateNotes":"","publicNotes":"<p>The catoblepas is an aggressive beast at the best of times. Though it prefers swamps, the catoblepas has been know to forage in plains and forests for short periods, leaving behind hunting grounds tainted by its foul breath and noxious waste that other predators and prey alike avoid for days or even weeks thereafter. The catoblepas bullies those creatures it believes are a match for it, and eats everything weaker.</p>\n<p>A catoblepas is 15 feet long and weighs 2,200 pounds.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core 2"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":22,"senses":[{"type":"darkvision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":24},"reflex":{"saveDetail":"","value":20},"will":{"saveDetail":"","value":22}},"skills":{"athletics":{"base":25},"intimidation":{"base":20},"stealth":{"base":22,"special":[{"base":24,"label":"in swamps","predicate":["terrain:swamp"]}]},"survival":{"base":20}},"traits":{"rarity":"common","size":{"value":"lg"},"value":["beast"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-monster-core-2.Actor.RA2dkQJANNFjgdSt"},"effects":[],"_key":"!actors!wsWp7pG7z3PRlp2E","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-monster-core-2/catoblepas.webp"}},"flag