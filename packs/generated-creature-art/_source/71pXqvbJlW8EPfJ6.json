finder Monster Core"},"rules":[{"domain":"attack-roll","key":"RollOption","option":"death-roll","toggleable":true},{"key":"FlatModifier","predicate":["death-roll","target:condition:grabbed"],"selector":"jaws-attack","type":"circumstance","value":2}],"slug":null,"traits":{"rarity":"common","value":["attack"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!71pXqvbJlW8EPfJ6.WLCM7iPJWfoRusL5"},{"_id":"OzGatkJy0uyM9zZJ","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.Tkd8sH4pwFIPzqTr"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Grab","sort":600000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Grab]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":"grab","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!71pXqvbJlW8EPfJ6.OzGatkJy0uyM9zZJ"}],"name":"Crocodile","system":{"abilities":{"cha":{"mod":-4},"con":{"mod":3},"dex":{"mod":1},"int":{"mod":-5},"str":{"mod":4},"wis":{"mod":1}},"attributes":{"ac":{"details":"","value":17},"allSaves":{"value":""},"hp":{"details":"","max":30,"temp":0,"value":30},"speed":{"otherSpeeds":[{"type":"swim","value":25}],"value":20}},"details":{"blurb":"","languages":{"details":"","value":[]},"level":{"value":2},"privateNotes":"","publicNotes":"<p>Crocodiles can be found basking on riverbanks, lurking in swamps, or floating in lakes. They are usually indistinguishable from logs when viewed from afar—at least until they attack. Alligators have similar statistics, but because they often live in more temperate climates, they endure cold temperatures better. Unlike alligators, crocodiles can tolerate salt water. Both are formidable predators that are likely to devour careless adventurers who fail to watch where they step.</p>\n<hr />\n<p>Powerful and primeval in appearance, crocodiles are dangerous natural predators that dwell in marshes, riverbeds, swamps, and other wetlands.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":7,"senses":[{"type":"low-light-vision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":9},"reflex":{"saveDetail":"","value":7},"will":{"saveDetail":"","value":5}},"skills":{"athletics":{"base":8},"stealth":{"base":7,"special":[{"base":11,"label":"in water","predicate":["terrain:water"]}]}},"traits":{"rarity":"common","size":{"value":"lg"},"value":["animal"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-monster-core.Actor.2rMLYkUR47ZCQMUg"},"effects":[],"_key":"!actors!71pXqvbJlW8EPfJ6","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-monster-core/crocodile.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pathfinder_monster_core__crocodile","sourcePack":"pf2e.pathfinder-monster-core","sourceDocId":"2rMLYkUR47ZCQMUg"}}}