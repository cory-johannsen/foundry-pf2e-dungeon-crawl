:{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>An eruption of skymetal blades churns the earth in a @Template[type:emanation|distance:40]. The area becomes difficult terrain and creatures touching the ground take @Damage[8d8[slashing]|options:area-damage] damage (basic @Check[reflex|dc:45|options:area-effect,inflicts:prone] save). Creatures that fail the save are knocked @UUID[Compendium.pf2e.conditionitems.Item.j91X7x0XSomq8d60]{Prone} and moved 20 feet in a direction of the dragon's choice.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"value":["metal","primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!N87Oinlk6KzmPzcY.KSqBtABr2yzytmqj"},{"_id":"uFP1Yw0V53Uii1mE","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.uJSseLa57HZYSMUu"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Swallow Whole","sort":1900000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>Large, @Damage[(4d12+12)[bludgeoning]], Rupture 40</p><hr /><p>@Localize[PF2E.NPC.Abilities.Glossary.SwallowWhole]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":"swallow-whole","traits":{"value":["attack"]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!N87Oinlk6KzmPzcY.uFP1Yw0V53Uii1mE"},{"_id":"2iyCQPtD05LBG8Gz","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.a0tx6exmB9v9CUsj"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Throw Rock","sort":2000000,"system":{