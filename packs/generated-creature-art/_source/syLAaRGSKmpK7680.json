e":null},"category":"offensive","description":{"value":"<p><strong>Saving Throw</strong> @Check[fortitude|dc:22]</p>\n<hr />\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> @Damage[1d8[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.MIRkyAjyBeXivMa7]{Enfeebled 1} (1 round)</p>\n<p><strong>Stage 2</strong> @Damage[1d8[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.MIRkyAjyBeXivMa7]{Enfeebled 2} (1 round)</p>\n<p><strong>Stage 3</strong> @Damage[2d8[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.MIRkyAjyBeXivMa7]{Enfeebled 3} (1 round).</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":"spiny-eurypterid-venom","traits":{"rarity":"common","value":["poison"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!syLAaRGSKmpK7680.06rO4SWWCzcZfK0D"},{"_id":"uBnRvlWD0zCwJWoX","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.Tkd8sH4pwFIPzqTr"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Grab","sort":700000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Grab]</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary"},"rules":[],"slug":"grab","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!syLAaRGSKmpK7680.uBnRvlWD0zCwJWoX"}],"name":"Spiny Eurypterid","system":{"abilities":{"cha":{"mod":-3},"con":{"mod":5},"dex":{"mod":2},"int":{"mod":-5},"str":{"mod":4},"wis":{"mod":1}},"attributes":{"ac":{"details":"","value":22},"allSaves":{"value":""},"hp":{"details":"","max":70,"temp":0,"value":70},"speed":{"otherSpeeds":[{"type":"swim","value":40}],"value":40}},"details":{"blurb":"","languages":{"details":"","value":[]},"level":{"value":5},"privateNotes":"","publicNotes":"<p>Spiny eurypterids are aggressive, tenacious, and utterly unwilling to stop chasing prey, even to their own detriment. These creatures are covered with countless needle-like spikes and can grow to rival the size of ocean mammals like orcas. Sailors often find them clinging to the hulls of ships, as spinyeurypterids mistake them for prey and are too stubborn to let go.</p>\n<hr />\n<p>Fearsome predators and durable pests, eurypterids are hard-carapaced arthropods sometimes referred to as sea scorpions. Though aquatic creatures, they have robust respiratory systems that allow them to survive indefinitely on land. All eurypterids possess claws as well as stingers that can inject venom.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary 3"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":10,"senses":[{"type":"darkvision"},{"acuity":"imprecise","range":30,"type":"wavesense"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":16},"reflex":{"saveDetail":"","value":11},"will":{"saveDetail":"","value":10}},"skills":{"athletics":{"base":13},"stealth":{"base":13}},"traits":{"rarity":"common","size":{"value":"lg"},"value":["amphibious","animal"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-bestiary-3.Actor.ChzqT42N5waJZ9VS"},"effects":[],"_key":"!actors!syLAaRGSKmpK7680","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-bestiary-3/spiny-eurypterid.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pathfinder_bestiary_3__spiny_eurypterid","sourcePack":"pf2e.pathfinder-bestiary-3","sourceDocId":"ChzqT42N5waJZ9VS"}}}