ium.pf2e.bestiary-ability-glossary-srd.Item.eQM5hQ1W3d1uen97"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Change Shape","sort":700000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>The vine leshy transforms into a Small plant with vines. This ability otherwise uses the effects of @UUID[Compendium.pf2e.spells-srd.Item.dileJ0Yxqg76LMvu]{One with Plants}.</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.ChangeShape]</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary"},"rules":[],"slug":"change-shape","traits":{"rarity":"common","value":["concentrate","polymorph","primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!SCmxINk9rNnsodTB.hUmX5vToV3dXSRRK"},{"_id":"1F2GCLISmzNTXa9u","img":"systems/pf2e/icons/actions/OneAction.webp","name":"Extend Vines","sort":800000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>The vine leshy Interacts to extend or shorten their arms. With limbs extended, the vine leshy has a 10-foot reach. The leshy can't use weapons that already have reach in this way, because they would be unable to keep their balance.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!SCmxINk9rNnsodTB.1F2GCLISmzNTXa9u"}],"name":"Vine Leshy","system":{"abilities":{"cha":{"mod":3},"con":{"mod":1},"dex":{"mod":1},"int":{"mod":-1},"str":{"mod":2},"wis":{"mod":2}},"attributes":{"ac":{"details":"","value":15},"allSaves":{"value":""},"hp":{"details":"","max":13,"temp":0,"value":13},"speed":{"otherSpeeds":[{"type":"climb","value":20}],"value":20}},"details":{"blurb":"","languages":{"details":"speak with plants (plants with vines only)","value":["common","fey","wildsong"]},"level":{"value":0},"privateNotes":"","publicNotes":"<p>Irrepressible vine leshys love to explore and collect tales to share. They're curious without being reckless. Other cultures interest them greatly, and they can build friendships quickly as they trade stories with traveling companions. They also feel a pull toward protection, much like other leshys. Vine leshys, though, tend to protect a ward for only a brief period of danger before the leshy's wanderlust drives them onward into the unknown.</p>\n<hr />\n<p>Often found assisting practitioners of nature magic, leshys are sentient flora that protect the natural world and sacred spaces within forests, fields, and other environments. Leshys are nature spirits inhabiting bodies constructed of plant matter fused together by a primal ritual.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary 3"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":6,"senses":[{"type":"low-light-vision"}]},"resources":{"focus":{"max":0,"value":0}},"saves":{"fortitude":{"saveDetail":"","value":3},"reflex":{"saveDetail":"","value":5},"will":{"saveDetail":"","value":8}},"skills":{"athletics":{"base":4},"diplomacy":{"base":5},"nature":{"base":4},"performance":{"base":5,"special":[{"base":6,"label":"for Oratory","predicate":["action:perform:oratory"]}]},"society":{"base":1},"survival":{"base":4}},"traits":{"rarity":"common","size":{"value":"sm"},"value":["leshy","plant"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-bestiary-3.Actor.H8PaAZanEOT85KjD"},"effects":[],"_key":"!actors!SCmxINk9rNnsodTB","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-bestiary-3/vine-leshy.webp"}},"flags":{"pf2e-du