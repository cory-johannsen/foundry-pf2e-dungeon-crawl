izes}. On a success, the target is @UUID[Compendium.pf2e.conditionitems.Item.xYTAsEpcJE1Ccni3]{Slowed} with a value equal to its @UUID[Compendium.pf2e.conditionitems.Item.TBSHQspnbcqxsmjL]{Frightened} value until it is no longer frightened.</p>"},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":null,"traits":{"value":["incapacitation","linguistic"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!5A086OI7jU4COW67.DkUqfGI2MSXGtBn4"},{"_id":"XNGlYvqucmbuKwez","img":"systems/pf2e/icons/default-icons/lore.svg","name":"Legal Lore","sort":1300000,"system":{"description":{"value":""},"mod":{"value":14},"proficient":{"value":0},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":null,"traits":{},"_migration":{"version":0.959,"previous":null}},"type":"lore","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!5A086OI7jU4COW67.XNGlYvqucmbuKwez"}],"name":"Gendarme","system":{"abilities":{"cha":{"mod":2},"con":{"mod":4},"dex":{"mod":1},"int":{"mod":0},"str":{"mod":4},"wis":{"mod":3}},"attributes":{"ac":{"details":"","value":26},"allSaves":{"value":"nerves of steel"},"hp":{"details":"","max":120,"temp":0,"value":120},"speed":{"otherSpeeds":[],"value":25}},"details":{"blurb":"","languages":{"details":"","value":["common"]},"level":{"value":8},"privateNotes":"","publicNotes":"<p>Powerful governments retain gendarmes to guard important magistrates, enforce laws protecting national security, reinstate order amid unrest, and capture unusually dangerous criminals. They're also sent to deal with important cases in rural areas without substantial guards of their own.</p><hr /><p>Larger societies rely on those with the authority and the ability to interpret and enforce laws. Some carry out these duties fairly, but others are harsh and cruel, imposing severe punishments on anyone unable to pay for clemency.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder NPC Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":19,"senses":[]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":19},"reflex":{"saveDetail":"","value":14},"will":{"saveDetail":"","value":17}},"skills":{"athletics":{"base":18},"intimidation":{"base":16}},"traits":{"rarity":"common","size":{"value":"med"},"value":["human","humanoid"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-npc-core.Actor.bzRxQ0Z317yeCUE5"},"effects":[],"_key":"!actors!5A086OI7jU4COW67","prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-npc-core/gendarme.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pathfinder_npc_core__gendarme","sourcePack":"pf2e.pathfinder-npc-core","sourceDocId":"bzRxQ0Z317yeCUE5"}}}