ions/Passive.webp","name":"Grasping Tail","sort":800000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>A khravgodon can drag a Large or smaller creature it has @UUID[Compendium.pf2e.conditionitems.Item.kWc1fhmv9LBiTuei]{Grabbed} with its tail along with it when it Strides.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!IDHPn5rc7eSQrvae.7c1InSV9VXV4cB8Z"},{"_id":"LcoYBqz5q98tSmXX","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.Tkd8sH4pwFIPzqTr"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Grab","sort":900000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Grab]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":"grab","traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!IDHPn5rc7eSQrvae.LcoYBqz5q98tSmXX"}],"name":"Khravgodon","system":{"abilities":{"cha":{"mod":0},"con":{"mod":5},"dex":{"mod":3},"int":{"mod":-4},"str":{"mod":6},"wis":{"mod":3}},"attributes":{"ac":{"details":"","value":27},"allSaves":{"value":"+2 circumstance to all saves vs. disease"},"hp":{"details":"","max":160,"temp":0,"value":160},"resistances":[{"type":"acid","value":10},{"type":"poison","value":10}],"speed":{"otherSpeeds":[{"type":"burrow","value":15},{"type":"climb","value":15}],"value":30}},"details":{"blurb":"","languages":{"details":"","value":[]},"level":{"value":9},"privateNotes":"","publicNotes":"<p>Few creatures can shrug off