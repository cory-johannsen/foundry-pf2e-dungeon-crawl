0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!sheSE5mRNpqXFeux.4rJZ9xscTEW4vAu2"},{"_id":"I1Su2avyR3JbgdtD","img":"systems/pf2e/icons/actions/TwoActions.webp","name":"Noxious Burst","sort":400000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>Toxic materials and churning rubbish within the filth fire's body explode in one of three ways. The filth fire chooses the effect, but it can't make the same choice twice in a row.</p><ul><li><strong>Fiery Beam</strong> (fire, primal) The filth fire expels a @Template[type:line|distance:30] of flame that deals @Damage[3d6[fire]|options:area-damage] damage with a @Check[reflex|dc:21|basic] save.</li><li><strong>Shrapnel Blast</strong> (primal) The filth fire shoots jagged rubbish out in a @Template[type:emanation|distance:5] that deals @Damage[2d12[piercing]|options:area-damage] damage with a @Check[reflex|dc:21|basic] save.</li><li><p><strong>Toxic Fumes</strong> (poison, primal) The filth fire belches a @Template[type:cone|distance:15] of toxic smoke that deals @Damage[2d6[poison]|options:area-damage] damage (@Check[fortitude|dc:21|basic] save). A creature that fails is also @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1} (@UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 2} on a critical failure).</p>\n</li></ul>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"value":["fire","poison","primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!sheSE5mRNpqXFeux.I1Su2avyR3JbgdtD"}],"name":"Filth Fire","system":{"abilities":{"cha":{"mod":0},"con":{"mod":4},"dex":{"mod":5},"int":{"mod":-2},"str":{"mod":1},"wis":{"mod":3}},"attributes":{"ac":{"details":"","value":21},"allSaves":{"value":""},"hp":{"details":"","max":70,"temp":0,"value":70},"immunities":[{"exceptions":[],"type":"bleed"},{"exceptions":[],"type":"fire"},{"exceptions":[],"type":"paralyzed"},{"exceptions":[],"type":"poison"},{"exceptions":[],"type":"sleep"}],"speed":{"otherSpeeds":[],"value":25},"weaknesses":[{"exceptions":[],"type":"cold","value":5}]},"details":{"blurb":"","languages":{"details":"Can't speak any language","value":["pyric"]},"level":{"value":4},"privateNotes":"","publicNotes":"<p>These creatures look like roiling clouds of black smoke churning above a mound of burning refuse. Leering faces form and fade in the smoke above, while the burning detritus writhes in spasmodic lurches, obviously alive.</p><hr /><p>Destructive manifestations of the Plane of Fire, fire elementals sometimes incorporate burning materials into their being or superheated matter, such as molten rock or searing smoke. In combat, they tend to be aggressive and somewhat reckless. Their attacks can sometimes cause major destruction to the surrounding environment, and many fire elementals seem to enjoy seeing their flames spread far and wide.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core 2"}},"initiative":{"statistic":"perception"},"perception":{"details":"smoke vision","mod":11,"senses":[{"type":"darkvision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":12},"reflex":{"saveDetail":"","value":13},"will":{"saveDetail":"","value":9}},"skills":{"acrobatics":{"base":13},"athletics":{"base":9}},"traits":{"rarity":"common","size":{"value":"med"},"value":["elemental","fire"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-monster-core-2.Actor.vdXh2dETJ21UlgUg"},"effects":[],"_key":"!actors!sheSE5mRNpqXFeux","folder":null,"prototypeToken":{"