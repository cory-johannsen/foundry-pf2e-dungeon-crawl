{"_id":"1SDgPXEVXIBcJ8wa","img":"modules/pf2e-dungeon-crawl/assets/creature-art/kingmaker-bestiary/hill-giant-butcher.webp","items":[{"_id":"DLI2axhKyDzeg5Ub","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","name":"Primal Innate Spells","sort":100000,"system":{"autoHeightenLevel":{"value":null},"description":{"value":""},"prepared":{"value":"innate"},"proficiency":{"value":1},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"showSlotlessLevels":{"value":false},"slots":{},"slug":null,"spelldc":{"dc":31,"value":23},"tradition":{"value":"primal"},"_migration":{"version":0.959,"previous":null}},"type":"spellcastingEntry","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!1SDgPXEVXIBcJ8wa.DLI2axhKyDzeg5Ub"},{"_id":"inmEPEibLEq2PlUV","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.spells-srd.Item.YWrfKetOqDwVFut7"},"img":"systems/pf2e/icons/spells/barkskin.webp","name":"Barkskin","sort":200000,"system":{"area":null,"cost":{"value":""},"counteraction":false,"damage":{},"defense":null,"description":{"value":"<p>The target's skin becomes covered in bark. The target gains resistance 2 to bludgeoning and piercing damage and weakness 3 to fire. After the target takes fire damage, it can Dismiss the spell as a free action triggered by taking the damage; doing so doesn't reduce the fire damage the target was dealt.</p>\n<p>@UUID[Compendium.pf2e.spell-effects.Item.HoOujAdQWCN4E6sQ]{Spell Effect: Oaken Resilience}</p>\n<hr />\n<p><strong>Heightened (+2)</strong> The resistances increase by 2, and the weakness increases by 3.</p>"},"duration":{"sustained":false,"value":"10 minutes"},"level":{"value":2},"location":{"heightenedLevel":6,"value":"DLI2axhKyDzeg5Ub"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Core Rulebook"},"range":{"value":"touch"},"requirements":"","rules":[],"slu