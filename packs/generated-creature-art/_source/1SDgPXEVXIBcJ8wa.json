E.NPC.Abilities.Glossary.CatchRock]</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary"},"rules":[{"key":"RollOption","option":"catch-rock","toggleable":true},{"key":"FlatModifier","predicate":["catch-rock"],"selector":["ac","saving-throw"],"type":"circumstance","value":4}],"slug":"catch-rock","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!1SDgPXEVXIBcJ8wa.T1WSPSyMbIh6gzFQ"},{"_id":"ZH9w82rcAvicGUV6","img":"systems/pf2e/icons/actions/OneAction.webp","name":"Menace Prey","sort":1500000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>The hill giant butcher designates up to two creatures they can see and hear, or one they're Tracking, as their prey. The hill giant butcher gains a +2 circumstance bonus to Perception checks to @UUID[Compendium.pf2e.actionspf2e.Item.BlAOM2X92SI6HMtJ]{Seek} the prey and to Intimidation checks to @UUID[Compendium.pf2e.actionspf2e.Item.2u915NdUyQan6uKF]{Demoralize} the prey. This effect lasts until the hill giant butcher uses Menace Prey again.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[{"domain":"ac","key":"RollOption","label":"Target of Menace Prey","option":"menace-prey","toggleable":true},{"key":"FlatModifier","predicate":["menace-prey","action:seek"],"selector":"perception","type":"circumstance","value":2},{"key":"FlatModifier","predicate":["menace-prey","action:demoralize"],"selector":"intimidation","type":"circumstance","value":2}],"slug":null,"traits":{"rarity":"common","value":["concentrate"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!1SDgPXEVXIBcJ8wa.ZH9w82rcAvicGUV6"},{"_id":"6gDHZ6VPfZDrKCnp","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.AWvNPE4U0kEJSL1T"},"img":"systems/pf2e/icons/actions/Passive.webp","name":"Sneak Attack","sort":1600000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>The hill giant butcher deals an extra 2d6 precision damage to @UUID[Compendium.pf2e.conditionitems.Item.AJh5ex99aV6VTggg]{Off-Guard} creatures.</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary"},"rules":[{"category":"precision","diceNumber":2,"dieSize":"d6","key":"DamageDice","predicate":["target:condition:off-guard"],"selector":"strike-damage"},{"key":"RollOption","label":"PF2E.SpecificRule.TOTMToggle.OffGuard","option":"target:condition:off-guard","toggleable":"totm"}],"slug":"sneak-attack","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!1SDgPXEVXIBcJ8wa.6gDHZ6VPfZDrKCnp"},{"_id":"093ZnioHRqaohRiq","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.a0tx6exmB9v9CUsj"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Throw Rock","sort":1700000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ThrowRock]</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Bestiary"},"rules":[],"slug":"throw-rock","traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!1SDgPXEVXIBcJ8wa.093ZnioHRqaohRiq"},{"_id":"Nu5hdhS5ABZ0CZjq","img":"systems/pf2e/icons/actions/OneAction.webp","name":"Twin Butchery","sort":1800000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p><strong>Frequency</strong> once per round;</p>\n<p><strong>Requirement</strong> the hill giant butcher is wielding two melee weapons, each in a different hand</p>\n<p><strong>Effect</strong> The hill giant butcher uses both of its axes against a single target. It makes two Strikes against its menaced prey, one with each of the required weapons. If both hit the same menaced prey, combine their damage for the purpose of its resistances and weaknesses. In addition, if both Strikes hit, the menaced prey is @UUID[Compendium.pf2e.conditionitems.Item.AJh5ex99aV6VTggg]{Off-Guard} until the start of the hill giant butcher's next turn. Apply the hill giant butcher's multiple attack penalty normally.</p>"},"frequency":{"max":1,"per":"round","value":1},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!1SDgPXEVXIBcJ8wa.Nu5hdhS5ABZ0CZjq"},{"_id":"xEHY10Oxi5BJJCmQ","img":"systems/pf2e/icons/actions/OneAction.webp","name":"Wide Swing","sort":1900000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>The hill giant makes a single greatclub Strike and compares the attack roll result to the ACs of up to two foes within its reach.</p>\n<p>This counts as two attacks for the hill giant's multiple attack penalty.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!1SDgPXEVXIBcJ8wa.xEHY10Oxi5BJJCmQ"}],"name":"Hill Giant Butcher","system":{"abilities":{"cha":{"mod":0},"con":{"mod":5},"dex":{"mod":4},"int":{"mod":-2},"str":{"mod":8},"wis":{"mod":5}},"attributes":{"ac":{"details":"","value":36},"allSaves":{"value":""},"hp":{"details":"","max":260,"temp":0,"value":260},"speed":{"otherSpeeds":[],"value":35}},"details":{"blurb":"Variant hill giant","languages":{"details":"","value":["common","jotun"]},"level":{"value":14},"privateNotes":"","publicNotes":"<p>Selfish and crude, these rough-skinned raiders are bullies and ultimately cowards. Quick-tempered and fond of violence, a hill giant gladly raids and pillages the defenseless but is quick to flee from those who are bigger, stronger, or better organized than they are. A hill giant is never above shoving or tricking one of their own kind to slow down their opponent or get the best loot.</p>\n<hr />\n<p>Giants are massive humanoid creatures who live in remote regions throughout the world. They are divided into a number of subtypes.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Kingmaker"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":25,"senses":[{"type":"low-light-vision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":28},"reflex":{"saveDetail":"","value":23},"will":{"saveDetail":"","value":26}},"skills":{"athletics":{"base":28},"intimidation":{"base":24},"survival":{"base":25}},"traits":{"rarity":"rare","size":{"value":"lg"},"value":["chaotic","earth","evil","giant","humanoid"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.kingmaker-bestiary.Actor.bF0FHdZMWl1OuRae"},"effects":[],"_key":"!actors!1SDgPXEVXIBcJ8wa","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/kingmaker-bestiary/hill-giant-butcher.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"kingmaker_bestiary__hill_giant_butcher","sourcePack":"pf2e.kingmaker-bestiary","sourceDocId":"bF0FHdZMWl1OuRae"}}}