EZrYYu"},"img":"systems/pf2e/icons/actions/Passive.webp","name":"Frightful Presence","sort":600000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>90 feet. @Check[will|dc:23|options:area-effect,inflicts:frightened]</p><hr /><p>@Localize[PF2E.NPC.Abilities.Glossary.FrightfulPresence]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[{"key":"Aura","radius":0,"slug":"frightful-presence","traits":["emotion","fear","mental"]}],"slug":"frightful-presence","traits":{"value":["aura","emotion","fear","mental"]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!aReeS5LQ5RCWPMcY.hfA70zaWuZGyWOuC"},{"_id":"II51rmEX3NRS3rAe","img":"systems/pf2e/icons/default-icons/action.svg","name":"Key Sense","sort":700000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>The Eye of Choral was created alongside several magical keys. It can sense the presence of these keys anywhere in Rahasia Rinca, communicate telepathically with anyone bearing a key within the complex, and always knows whether a creature possesses such a key.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"value":["detection"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!aReeS5LQ5RCWPMcY.II51rmEX3NRS3rAe"},{"_id":"LBxPiVEwr6YcuylX","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.W7SbTykXrNwxDzJc"},"img":"systems/pf2e/icons/actions/Reaction.webp","name":"Reactive Strike (Jaws Only)","sort":800000,"system":{"actionType":{"value":"reaction"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ReactiveStrike]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[],"slug":"reactive-strike","traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!aReeS5LQ5RCWPMcY.LBxPiVEwr6YcuylX"},{"_id":"wWFynturzRrVqvWi","img":"systems/pf2e/icons/default-icons/action.svg","name":"Shadow Construct","sort":900000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>The Eye of Choral is only semi-real. The first time each round a PC is hit by one of the Eye's Strikes, the creature makes a @Check[will|dc:23] save to realize the creature's attacks aren't wholly real. The result applies to the damage of that Strike and lasts until the start of the creature's next turn.</p><hr /><p><strong>Critical Success</strong> The creature gains resistance to damage from the Eye's Strikes equal to its level.</p>\n<p><strong>Success</strong> The creature gains resistance to damage from the Eye's Strikes equal to half its level.</p>\n<p><strong>Failure</strong> The creature is affected by the Eye's Strikes as normal.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[{"key":"Immunity","mode":"remove","type":["doomed","drained","fatigued","healing","nonlethal-attacks","sickened","spirit","vitality","void"]}],"slug":null,"traits":{"value":["illusion"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!aReeS5LQ5RCWPMcY.wWFynturzRrVqvWi"},{"_id":"QFNmogI6zwgHkHxc","img":"systems/pf2e/icons/default-icons/action.svg","name":"Draconic Frenzy","sort":1000000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>The Eye makes two claw Strikes and one wing Strike in any order</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!aReeS5LQ5RCWPMcY.QFNmogI6zwgHkHxc"},{"_id":"lmT8KIC1FafklMOD","img":"systems/pf2e/icons/default-icons/action.svg","name":"Draconic Momentum","sort":1100000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>The Eye recharges their Pyre Breath whenever they score a critical hit with a Strike.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[{"key":"Note","outcome":["criticalSuccess"],"selector":"strike-attack-roll","text":"{item|description}","title":"{item|name}","visibility":"owner"}],"slug":null,"traits":{"value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!aReeS5LQ5RCWPMcY.lmT8KIC1FafklMOD"},{"_id":"nmHUJbIOyJCbVWIh","img":"systems/pf2e/icons/default-icons/action.svg","name":"Pyre Breath","sort":1200000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>The Eye breathes a blast of flame that deals @Damage[7d6[fire]|options:area-damage] damage in a @Template[type:cone|distance:40] (@Check[reflex|dc:23|basic|options:area-effect] save). Creatures that critically fail their save catch fire, taking @Damage[1d6[persistent,fire]|options:area-damage] damage. The area then fills with black smoke for 1 minute. This has the effects of mist, except it fills the cone's area. The Eye can't use Pyre Breath again for [[/gmr 1d4 #Recharge Pyre Breath]]{1d4 rounds}.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"value":["fire","primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!aReeS5LQ5RCWPMcY.nmHUJbIOyJCbVWIh"},{"_id":"qmgLZswwX5TMFlx9","img":"systems/pf2e/icons/default-icons/action.svg","name":"Stoke the Flames","sort":1300000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>The Eye intensifies nearby fires. Every foe within 60 feet that is taking persistent fire damage takes @Damage[2d6[fire]] damage.</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"value":["fire","primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!aReeS5LQ5RCWPMcY.qmgLZswwX5TMFlx9"},{"_id":"cyMCTZ1UhJyoF71w","img":"systems/pf2e/icons/default-icons/lore.svg","name":"Brevoy Lore","sort":1400000,"system":{"description":{"value":""},"mod":{"value":15},"proficient":{"value":0},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{},"_migration":{"version":0.959,"previous":null}},"type":"lore","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!aReeS5LQ5RCWPMcY.cyMCTZ1UhJyoF71w"},{"_id":"anQWaFpZRNfwbzFP","img":"systems/pf2e/icons/default-icons/lore.svg","name":"House Rogarvia Lore","sort":1500000,"system":{"description":{"value":""},"mod":{"value":20},"proficient":{"value":0},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{},"_migration":{"version":0.959,"previous":null}},"type":"lore","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"