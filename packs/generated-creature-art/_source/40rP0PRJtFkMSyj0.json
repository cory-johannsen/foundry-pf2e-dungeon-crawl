ense":"ORC","remaster":true,"title":"Pathfinder Player Core"},"quantity":1,"range":60,"reload":{"value":"0"},"rules":[],"runes":{"potency":0,"property":[],"striking":0},"size":"med","slug":"shortbow","splashDamage":{"value":0},"traits":{"rarity":"common","value":["deadly-d10"]},"usage":{"value":"held-in-one-plus-hands"},"_migration":{"version":0.959,"previous":null}},"type":"weapon","effects":[],"_key":"!actors.items!40rP0PRJtFkMSyj0.BQ28rceNe7mavl1D"},{"_id":"iYWcxAxjnGp9gag8","flags":{"pf2e":{"linkedWeapon":"PDk5irePkj7swYlp"}},"img":"systems/pf2e/icons/default-icons/melee.svg","name":"Hatchet","sort":800000,"system":{"attack":{"value":""},"attackEffects":{"custom":"","value":["pukwudgie-poison"]},"bonus":{"value":17},"damageRolls":{"0":{"damage":"1d6+10","damageType":"slashing"}},"description":{"value":""},"publication":{"license":"ORC","remaster":true,"title":""},"range":null,"rules":[],"slug":null,"traits":{"rarity":"common","value":["agile","magical","sweep"]},"_migration":{"version":0.959,"previous":null}},"type":"melee","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!40rP0PRJtFkMSyj0.iYWcxAxjnGp9gag8"},{"_id":"WUlRpT25Akwrbx9n","flags":{"pf2e":{"linkedWeapon":"PDk5irePkj7swYlp"}},"img":"systems/pf2e/icons/default-icons/melee.svg","name":"Hatchet","sort":900000,"system":{"attack":{"value":""},"attackEffects":{"custom":"","value":["pukwudgie-poison"]},"bonus":{"value":19},"damageRolls":{"0":{"damage":"1d6+10","damageType":"slashing"}},"description":{"value":""},"publication":{"license":"ORC","remaster":true,"title":""},"range":null,"rules":[],"slug":null,"traits":{"rarity":"common","value":["magical","thrown-10"]},"_migration":{"version":0.959,"previous":null}},"type":"melee","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!40rP0PRJtFkMSyj0.WUlRpT25Akwrbx9n"},{"_id":"c3sGdZtwuCDBGlig","flags":{"pf2e":{"linkedWeapon":"BQ28rceNe7mavl1D"}},"img":"systems/pf2e/icons/default-icons/melee.svg","name":"Shortbow","sort":1000000,"system":{"attack":{"value":""},"attackEffects":{"custom":"","value":["pukwudgie-poison"]},"bonus":{"value":18},"damageRolls":{"0":{"damage":"1d6+6","damageType":"piercing"}},"description":{"value":""},"publication":{"license":"ORC","remaster":true,"title":""},"range":{"increment":60,"max":null},"rules":[],"slug":null,"traits":{"rarity":"common","value":["deadly-d10"]},"_migration":{"version":0.959,"previous":null}},"type":"melee","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!40rP0PRJtFkMSyj0.c3sGdZtwuCDBGlig"},{"_id":"JQcN49zNIu4wTuSg","img":"systems/pf2e/icons/actions/Passive.webp","name":"Defensive Quills","sort":1100000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>A creature that hits a pukwudgie with an unarmed Strike or a non-reach melee Strike takes @Damage[3d8[piercing]] damage (@Check[reflex|dc:22|basic] save). On a critical failure, the creature also takes @Damage[1d6[persistent,poison]] from the poisoned quills.</p>\n<hr />\n<p><em>Note: A DC was not provided for this ability by Paizo. The DC present here is a moderate DC for the creature level according to the GM Core creature building Tables</em></p>"},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!40rP0PRJtFkMSyj0.JQcN49zNIu4wTuSg"},{"_id":"e81mjeZGp9mKBDKv","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.eQM5hQ1W3d1uen97"},"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Change Shape","sort":1200000,"system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>The pukwudgie takes on the physical form of a giant porcupine or resumes their natural form. In porcupine form, their size changes to Medium, they lose their weapon Strikes, and they gain a quill Strike (+18 for 2d8+6 piercing plus 1d8 persistent poison).</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.ChangeShape]</p>"},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"},"rules":[{"alwaysActive":true,"key":"RollOption","label":"PF2E.NPCAbility.ChangeShape.Label","option":"change-shape","selection":"pukwudgie","suboptions":[{"label":"PF2E.NPCAbility.ChangeShape.Form.Pukwudgie","value":"pukwudgie"},{"label":"PF2E.NPCAbility.ChangeShape.Form.Animal.Specific.PorcupineGiant","value":"porcupine-giant"}],"toggleable":true,"value":true},{"key":"CreatureSize","predicate":["change-shape:porcupine-giant"],"value":"medium"},{"attackModifier":18,"damage":{"base":{"damageType":"piercing","dice":2,"die":"d8","modifier":6}},"key":"Strike","label":"PF2E.BattleForm.Attack.Quill","predicate":["change-shape:porcupine-giant"],"replaceAll":true,"slug":"quill","traits":[]},{"category":"persistent","damageType":"poison","diceNumber":1,"dieSize":"d8","key":"DamageDice","label":"PF2E.BattleForm.Attack.Quill","selector":"quill-damage"}],"slug":"change-shape","traits":{"rarity":"common","value":["concentrate","polymorph","primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","effects":[],"_key":"!actors.items!40rP0PRJtFkMSyj0.e81mjeZGp9mKBDKv"},{"_id":"lV8lCapoUOFDMPz8","img":"systems/pf2e/icons/actions/Passive.webp","name":"Pukwudgie Poison","sort":1300000,"system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"offensive","description":{"value":"<p><strong>Saving Throw</strong> @Check[fortitude|dc:25]</p>\n<hr />\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> @Damage[1d6[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.e1XGnhKNSQIm5IXg]{Stupefied 1} (1 round)</p>\n<p><strong>Stage 2</strong> @Damage[1d6[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.e1XGnhKNSQIm5IXg]{Stupefied 2} (1 round)</p>\n<p><strong>Stage 3</strong> @Damage[1d6[poison]] damage, @UUID[Compendium.pf2e.conditionitems.Item.yblD8fOR1J8rDwEQ]{Confused}, and stupefied 2 (1 round)</p>"},"publication":{"license":"ORC","remaster":true,"title":""},"rules":[],"slug":"pukwudgie-poison","traits":{"rarity":"common","value":["poison"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!40rP0PRJtFkMSyj0.lV8lCapoUOFDMPz8"}],"name":"Pukwudgie","system":{"abilities":{"cha":{"mod":3},"con":{"mod":3},"dex":{"mod":6},"int":{"mod":4},"str":{"mod":4},"wis":{"mod":6}},"attributes":{"ac":{"details":"","value":25},"allSaves":{"value":""},"hp":{"details":"","max":100,"temp":0,"value":100},"resistances":[{"type":"poison","value":5}],"speed":{"otherSpeeds":[],"value":25},"weaknesses":[{"type":"cold-iron","value":10}]},"details":{"blurb":"","languages":{"details":"","value":["common","elven","fey","gnomish"]},"level":{"value":7},"privateNotes":"","publicNotes":"<p>Pukwudgies go by many names in many regions, but those who know of them agree that defying their mischievous nature provokes their wrath.</p>\n<p>In ancient times, pukwudgies traveled to the Universe from the First World, perhaps in the wake of the gnome emigration. These proud fey are obsessed with displays of respect, and while they first attempted to befriend mortals, each attempt ended in tragedy as the pukwudgies perceived any potential slight as a grave insult. Mortals, fearing these reactions, began to view pukwudgies as dangerous nuisances. Pukwudgies, in turn, began to resent mortals and the gods that favored them.</p>\n<p>At their best, pukwudgies play cruel jokes on mortals they encounter. At their worst, they've been known to kidnap and even kill those who don't treat them with proper respect. Violent fey like twigjacks and redcaps often gather under pukwudgie leadership, much to the pukwudgies' glee.</p>\n<p>Pukwudgies make their villages in the oldest forests, concealed under @UUID[Compendium.pf2e.spells-srd.Item.HBJPsonQnWcC3qdX]{Mirage} spells. They travel freely between the Universe and the First World through tiny portals beneath hills, trees, or stones. No strangers to violence, pukwudgies rarely travel alone and often anoint their quills or weapons with a custom-brewed poison before entering hostile situations.</p>\n<p>Standing about 2 feet tall, a pukwudgie sports sharp quills growing from their head that extends down their back. Their skin tone varies by the region in which they live, ranging from pale gray to brown.</p>","publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":17,"senses":[{"type":"low-light-vision"}]},"resources":{"focus":{"max":0,"value":0}},"saves":{"fortitude":{"saveDetail":"","value":12},"reflex":{"saveDetail":"","value":15},"will":{"saveDetail":"","value":17}},"skills":{"crafting":{"base":15},"deception":{"base":14},"medicine":{"base":15},"nature":{"base":17},"stealth":{"base":17},"thievery":{"base":15}},"traits":{"rarity":"common","size":{"value":"sm"},"value":["fey"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":"Compendium.pf2e.pathfinder-monster-core.Actor.1ZRHjuGOluR4IUrs"},"effects":[],"_key":"!actors!40rP0PRJtFkMSyj0","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/shared/pukwudgie.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"shared__pathfinder_monster_core__pukwudgie","sourcePack":"pf2e.pathfinder-monster-core","sourceDocId":"1ZRHjuGOluR4IUrs"}}}