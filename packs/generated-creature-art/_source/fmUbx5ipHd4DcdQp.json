ptions:fall-damage]{15} damage for a 30-foot fall). If the flung creature lands on another creature, the creature it lands on takes the same amount of bludgeoning damage (@Check[reflex|dc:28|basic] save).</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!fmUbx5ipHd4DcdQp.tsSp16VjrpJtFEwI"},{"_id":"dU8SZGSCK9sOJTIa","img":"systems/pf2e/icons/actions/TwoActions.webp","name":"Shambling Trample","sort":800000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>As @UUID[Compendium.pf2e.bestiary-ability-glossary-srd.Item.UNah0bxXxkcZjxO3]{Trample}, but the tar zombie mammoth Strides up to its Speed instead of double its Speed.</p>"},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder #177: Burning Tundra"},"rules":[],"slug":null,"traits":{"rarity":"common","value":[]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!fmUbx5ipHd4DcdQp.dU8SZGSCK9sOJTIa"},{"_id":"oWRHeQlKpU13eZfQ","img":"systems/pf2e/icons/actions/TwoActions.webp","name":"Vomit Tar","sort":900000,"system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>The tar zombie vomits a gout of sticky tar in a @Template[cone|distance:15] that deals @Damage[7d6[bludgeoning]|options:area-damage] damage ((@Check[reflex|dc:28|basic|options:area-effect,inflicts:slowed]) save). Creatures that fail the save are @UUID[Compendium.pf2e.conditionitems.Item.xYTAsEpcJE1Ccni3]{Slowed 1} and gain fire weakness 5. Both conditions end after 3 rounds or when the tar is scrubbed off (which requires 3 Interact actions). The tar zombie can't Vomit Tar again for [[/gmr 1d4 #Recharge Vomit Tar]]{1d4 rounds}.</p>\n<p>@UUID[Compendium.pf2e.bestiary-effects.Item.4X4wCxkxr9rJdoT1]{Effect: Vomit Tar}</p>"},"publication":{"license":"OGL","remaster":false,"title":""},"rules":[],"slug":null,"traits":{"rarity":"common","value":["primal"]},"_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.361","systemId":"pf2e","systemVersion":"8.5.0","compendiumSource":null},"effects":[],"_key":"!actors.items!fmUbx5ipHd4DcdQp.oWRHeQlKpU13eZfQ"}],"name":"Tar Zombie Mammoth","system":{"abilities":{"cha":{"mod":-3},"con":{"mod":5},"dex":{"mod":-1},"int":{"mod":-5},"str":{"mod":7},"wis":{"mod":1}},"attributes":{"ac":{"details":"","value":26},"allSaves":{"value":""},"hp":{"details":"void healing","max":240,"temp":0,"value":240},"immunities":[{"type":"bleed"},{"type":"death-effects"},{"type":"disease"},{"type":"paralyzed"},{"type":"poison"},{"type":"unconscious"}],"speed":{"otherSpeeds":[],"value":30},"weaknesses":[{"type":"fire","value":10},{"type":"vitality","value":10},{"type":"slashing","value":10}]},"details":{"blurb":"","languages":{"details":"","value":[]},"level":{"value":9},"privateNotes":"<p>Slow A tar zombie is permanently @UUID[Compendium.pf2e.conditionitems.Item.xYTAsEpcJE1Ccni3]{Slowed 1} and can't use reactions.</p>","publicNotes":"","publication":{"license":"OGL","remaster":false,"title":"Pathfinder #177: Burning Tundra"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":18,"senses":[{"type":"darkvision"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":22},"reflex":{"saveDetail":"","value":14},"will":{"saveDetail":"","value":16}},"skills":{"athletics":{"base":20},"stealth":{"base":12,"special":[{"base":16,"label":"in tar pits","predicate":["terrain:tar-pit"]}]}},"traits":{"rarity":"uncommon","size":{"value":"huge"},"value":["evil","mindless","undead","unholy","zombie"]},"_migration":{"ve