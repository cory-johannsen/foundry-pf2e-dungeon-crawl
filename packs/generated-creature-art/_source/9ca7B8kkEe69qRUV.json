.1AZoRkLec47xrTqY"},"effects":[],"_key":"!actors!9ca7B8kkEe69qRUV","folder":null,"prototypeToken":{"texture":{"src":"modules/pf2e-dungeon-crawl/assets/creature-art/pathfinder-monster-core/living-waterfall.webp"}},"flags":{"pf2e-dungeon-crawl":{"artEntryId":"pathfinder_monster_core__living_waterfall","sourcePack":"pf2e.pathfinder-monster-core","sourceDocId":"1AZoRkLec47xrTqY"}}}